---
import {
  AREAS_BY_EXAM,
  EXAMS,
  EXAM_FORMAT,
  SUBJECTS_BY_EXAM,
  TOPICS,
  examPath,
  memosOf,
} from "../content.config";
import { loadBank, loadPractical } from "../lib/bank";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { AUTHOR } from "../lib/author";
import { version } from "../../package.json";
import "../styles/global.css";

// 소개 — 이 사이트가 무엇이고 무엇으로 만들어졌는지. daily.mcp 블로그의 /about/과 짝이다.
//
// 숫자는 하나도 손으로 적지 않는다. 문항·주제·카드 수는 늘 바뀌는데 소개 글이 그걸 서술로
// 들고 있으면 가장 먼저 낡는다(CLAUDE.md가 "숫자로 적힌 서술이 특히 어긋나기 쉽다"고 적어 둔
// 바로 그 자리다). 전부 빌드 타임에 은행에서 센다.
const bank = await loadBank();
const pbank = await loadPractical();

const stats = EXAMS.map((exam) => {
  const f = EXAM_FORMAT[exam];
  const topics = Object.values(TOPICS).filter((t) => t.exam === exam);
  return {
    exam,
    label: f.label,
    path: examPath(exam),
    written: bank.filter((q) => q.exam === exam).length,
    practical: pbank.filter((q) => q.exam === exam).length,
    memo: memosOf(exam).length,
    topics: topics.length,
    areas: AREAS_BY_EXAM[exam].length,
    subjects: SUBJECTS_BY_EXAM[exam].length,
    format: f,
  };
});
const total = {
  written: bank.length,
  practical: pbank.length,
  topics: Object.keys(TOPICS).length,
  memo: new Set(stats.flatMap((s) => memosOf(s.exam).map((m) => m.key))).size,
  linked: Object.values(TOPICS).filter((t) => t.post).length,
};
/** v1.0.0 태그의 날짜. 이것만은 은행에서 셀 수 없어 적어 둔다 — 한 번 일어난 일이라 바뀌지 않는다 */
const FIRST_RELEASE = "2026-08-24";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const BLOG = "https://mmyonaa.github.io/blog/";
const REPO = "https://github.com/mmyonaa/quiz";

/** 한 시험의 실기 형식을 한 줄로 — 두 시험이 다르다(정처기 20문항 균일 / 정보보안기사 유형별 배점).
    값은 채점기(PRACTICAL_FORMAT)가 단일 정의를 갖고 여기서는 읽기만 한다. */
const practicalLine = (f: (typeof stats)[number]["format"]["practical"]) =>
  [`${f.total}문항`, `${f.minutes}분`, `${f.pass}점 합격`].join(" · ");

/**
 * 현황 표의 행. 프런트매터는 TypeScript라 마크업을 담을 수 없으므로 **값만** 둔다 —
 * num이 있는 줄은 템플릿이 숫자를 mono 칩으로 세우고 단위를 붙이고(화면 규약 3),
 * 없는 줄은 text를 그대로 쓴다.
 *
 * same은 "두 시험이 같은 값인가"다. 같은 줄은 표에서 빠져 아래 한 줄로 합쳐진다 —
 * 대조표는 다른 것을 보여 주는 자리라 같은 값이 섞이면 눈이 그 줄에서 헛돈다.
 * 어느 줄이 같은지는 지금 값으로 판정한다. 못 박아 두면 나중에 한쪽이 바뀌었을 때
 * 표가 조용히 거짓말을 한다.
 */
type Stat = (typeof stats)[number];
const ROWS: { k: string; num?: (s: Stat) => number; unit?: string; text?: (s: Stat) => string }[] = [
  { k: "필기", num: (s) => s.written, unit: "문항" },
  { k: "실기", num: (s) => s.practical, unit: "문항" },
  { k: "개념 주제", num: (s) => s.topics, unit: "개" },
  { k: "암기 카드", num: (s) => s.memo, unit: "장" },
  { k: "과목 · 영역", text: (s) => `${s.subjects}과목 · ${s.areas}영역` },
  {
    k: "필기 시험",
    text: (s) => `${s.subjects * s.format.written.perSubject}문항 · ${s.format.written.minutes}분`,
  },
  { k: "실기 시험", text: (s) => practicalLine(s.format.practical) },
];
/** 판정과 표시에 같은 문자열을 쓴다 — 둘이 갈리면 "같다"고 말해 놓고 다른 값을 보일 수 있다 */
const cellText = (r: (typeof ROWS)[number], s: Stat) =>
  r.num ? `${r.num(s)}${r.unit ?? ""}` : (r.text?.(s) ?? "");
const rows = ROWS.map((r) => ({ ...r, same: new Set(stats.map((s) => cellText(r, s))).size === 1 }));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — about</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={`정보처리기사·정보보안기사를 풀고 외우는 정적 연습장 — 필기 ${total.written}문항 · 실기 ${total.practical}문항 · ${total.topics}개 주제. 서버 없이 동작하고 모든 문항은 AI가 만든 자체 제작 콘텐츠입니다.`}
    />
  </head>
  <body>
    <SiteHeader current="about" shared />

    <main>
      <section class="panel flat about">
        {/* 머리 — daily.mcp 블로그의 /about/과 같은 차례다: 아이콘 · 이름 · 링크 줄 · 설명 ·
            현황 한 문장. "소개" 같은 제목은 두지 않는다(블로그도 바로 내용으로 들어간다).
            거기는 사람의 블로그라 저자 이름과 프로필 사진이 서고, 여기는 사이트라 사이트명과
            파비콘이 그 자리에 선다. */}
        {/* 머리 — daily.mcp 블로그의 /about/과 같은 구조다(site/src/pages/about/index.astro).
            아바타 · 이름과 주소 · 아이콘 링크 셋이 한 줄에 서고 링크는 오른쪽 끝에 붙는다.
            저자 정보는 lib/author.ts 가 단일 출처이고, 이메일은 봇을 피해 쪼개 두었다가
            클라이언트가 mailto로 조립한다 — 블로그와 같은 수법이다. */}
        <header class="about-hero">
          <img class="ab-avatar" src={AUTHOR.avatar} alt="" width="72" height="72" loading="eager" decoding="async" />
          <div class="ab-id">
            <h1 class="ab-name">{AUTHOR.name}</h1>
            <a class="ab-portfolio" href={AUTHOR.portfolio} target="_blank" rel="noopener">{AUTHOR.portfolioLabel}</a>
          </div>
          <div class="ab-social">
            <a href={AUTHOR.github} target="_blank" rel="noopener" aria-label="GitHub">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            </a>
            <a href={AUTHOR.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.632 13.635h-2.37V9.922c0-.886-.018-2.025-1.234-2.025-1.235 0-1.424.964-1.424 1.96v3.778h-2.37V6H8.51v1.04h.032c.317-.6 1.09-1.233 2.244-1.233 2.4 0 2.845 1.58 2.845 3.637v4.19zM3.558 4.955a1.376 1.376 0 1 1 .002-2.752 1.376 1.376 0 0 1-.002 2.752zm1.188 8.68H2.368V6h2.378v7.635zM14.816 0H1.18C.528 0 0 .516 0 1.153v13.694C0 15.484.528 16 1.18 16h13.635c.652 0 1.185-.516 1.185-1.153V1.153C16 .516 15.467 0 14.815 0z"></path></svg>
            </a>
            <a class="about-mail" href="#" data-mail-user={AUTHOR.mailUser} data-mail-domain={AUTHOR.mailDomain} aria-label="이메일 보내기">
              <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M2 3h12a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm0 1v.4l6 3.6 6-3.6V4H2Zm12 1.567-5.74 3.444a.5.5 0 0 1-.52 0L2 5.567V12h12V5.567Z"></path></svg>
            </a>
          </div>
        </header>

        <div class="about-body">
          <p class="lead">
            정보처리기사와 정보보안기사를 <strong>풀고 · 읽고 · 외우는</strong> 연습장입니다.
            필기는 4지선다로, 실기는 답을 직접 적어 풀고 즉시 채점과 해설을 받습니다.
            <a class="lead-link" href={BLOG} target="_blank" rel="noopener">daily.mcp</a> 블로그의
            자매 프로젝트로, 문제의 해설이 블로그의 개념 글로 이어집니다.
          </p>
          {/* 현황도 블로그처럼 문장 안에 둔다 — 큰 숫자 타일로 세우면 자랑이 되고,
              문장에 담으면 "지금 이만큼 있다"는 사실로 읽힌다. 숫자는 은행에서 센다. */}
          <p class="about-count">
            {FIRST_RELEASE} 첫 릴리스 이후 필기 <b class="mono">{total.written}</b>문항 ·
            실기 <b class="mono">{total.practical}</b>문항 · 개념 주제 <b class="mono">{total.topics}</b>개 ·
            암기 카드 <b class="mono">{total.memo}</b>장을 쌓았습니다.
          </p>

        {/* 현황 — 이 사이트가 지금 무엇을 들고 있는지. 손으로 적지 않고 은행에서 센다 */}
        <h2 class="group-title">시험별로는</h2>
        {/* 대조표는 다른 것을 보여 주는 자리다 — 두 시험이 같은 값인 줄이 섞이면(과목·영역 수,
            필기 시험 형식은 실제로 같다) 눈이 그 줄에서 헛돈다. 같은 값은 표 밖 한 줄로 빼고
            표에는 갈리는 것만 남긴다. 어느 줄이 같은지는 지금 값으로 판정한다 — 못 박아 두면
            나중에 한쪽이 바뀌었을 때 표가 조용히 거짓말을 한다.
            data-h는 좁은 화면에서 각 칸이 제 시험 이름을 앞에 달고 서게 한다(암기 노트와 같은 장치). */}
        <div class="cmp-wrap">
          <table class="cmp cmp-wide">
            <thead>
              <tr><th></th>{stats.map((s) => <th>{s.label}</th>)}</tr>
            </thead>
            <tbody>
              {rows.filter((r) => !r.same).map((row) => (
                <tr>
                  <th scope="row">{row.k}</th>
                  {stats.map((s) => (
                    <td data-h={s.label}>
                      <span class="cv">
                        {row.num ? <><b class="mono">{row.num(s)}</b>{row.unit}</> : row.text?.(s)}
                      </span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {/* 같은 값은 "무엇이 같은지"를 먼저 말하고 값을 괄호로 받는다. 라벨과 값이 둘 다
            가운뎃점을 쓰는 탓에(과목 · 영역 / 5과목 · 6영역) 그냥 이어 놓으면 어디까지가
            이름인지 흐려졌다. */}
        {rows.some((r) => r.same) && (
          <p class="about-note">
            <b>두 시험이 같은 것</b>
            {rows.filter((r) => r.same).map((r) => (
              <span class="about-same">{r.k}<em>{cellText(r, stats[0])}</em></span>
            ))}
          </p>
        )}
        <p class="about-note">
          주제 {total.topics}개 가운데 {total.linked}개가 블로그 개념 글과 이어져 있습니다.
          나머지는 노트 안의 도입부만으로 완결됩니다.
        </p>

        {/* 무엇이 있나 — 화면 하나하나가 무슨 자리인지 */}
        <h2 class="group-title">무엇이 있나</h2>
        <div class="about-grid">
          <section class="about-card">
            <h3><a href={`${base}/`}>필기 연습 · 모의고사</a></h3>
            <p>영역·문항 수·난이도를 골라 풀고 바로 채점합니다. 모의고사는 실제 비중대로 100문항·150분을 재고 과락까지 판정합니다.</p>
          </section>
          <section class="about-card">
            <h3><a href={`${base}/practical/`}>실기 필답</a></h3>
            <p>보기 없이 답을 직접 입력합니다. 단답·계산·코드 출력·SQL은 자동 채점하고, 약술형은 모범답안과 핵심어를 대조해 스스로 매깁니다.</p>
          </section>
          <section class="about-card">
            <h3><a href={`${base}/notes/`}>개념 노트</a></h3>
            <p>해설을 영역·주제별로 모아 읽는 자리입니다. 주제마다 자족적인 도입부가 먼저 오고, 그 아래 정답을 가린 확인 문제가 붙습니다.</p>
          </section>
          <section class="about-card">
            <h3><a href={`${base}/memo/`}>암기 노트</a></h3>
            <p>개념 노트가 "왜"라면 여기는 "무엇"입니다. 줄글 없이 두문자·표·순서 흐름으로만 모았고, 가리기를 켜면 외울 값이 덮입니다.</p>
          </section>
          <section class="about-card">
            <h3>오답노트</h3>
            <p>틀린 문제가 저절로 쌓이고, 맞히면 <b class="mono">1</b> → <b class="mono">3</b> → <b class="mono">7</b>일로 다시 볼 시점을 미룹니다. 마지막 단계를 넘기면 졸업합니다.</p>
          </section>
          <section class="about-card">
            <h3><a href={`${base}/my/`}>마이페이지</a></h3>
            <p>로그인하면 북마크와 오답 기록이 계정에 남아 기기를 옮겨도 이어집니다. 로그인 전에도 이 기기에 쌓인 것은 그대로 보입니다.</p>
          </section>
        </div>

        {/* 어떻게 만들어지나 — 블로그 /about/의 같은 절과 짝이다 */}
        <h2 class="group-title">어떻게 만들어지나</h2>
        <p>
          모든 문항과 해설은 <strong>AI(Claude)</strong>가 블로그의 개념 글을 바탕으로 쓴 자체 제작
          콘텐츠입니다. 기출을 복제하지 않고, 대신 기출을 <strong>기준선</strong>으로 삼아 유형과 난이도를
          맞춥니다. 사람이 읽어야 지켜지는 규칙은 지켜지지 않으므로, 품질은 문서가 아니라
          <strong>빌드 게이트</strong>가 강제합니다.
        </p>
        <div class="about-grid">
          <section class="about-card">
            <h3>발행 게이트</h3>
            <p>스키마를 어긴 문항은 빌드가 실패해 사이트에 실리지 않습니다. 없는 주제를 쓰거나, 영역이 어긋나거나, 강조 표기가 상한을 넘으면 그 자리에서 막힙니다.</p>
          </section>
          <section class="about-card">
            <h3>병합 도구</h3>
            <p>새 문항은 은행에 <em>쓰이기 전에</em> 검사합니다. 스키마가 원리상 못 보는 것 — 문항 사이의 중복, 발문이 정답을 품는 결함 — 이 여기서 걸립니다.</p>
          </section>
          <section class="about-card">
            <h3>현황 리포트</h3>
            <p>기계는 "무엇을 칠했는가"를 못 봅니다. 대신 영역별 밀도와 정답 위치 분포를 숫자로 보여 주고, 다음에 어디를 메울지는 사람이 고릅니다.</p>
          </section>
        </div>

        <h2 class="group-title">세 가지 원칙</h2>
        <dl class="about-principles">
          <dt>서버 없이</dt>
          <dd>문제·정답·해설을 빌드 타임에 HTML로 굽고, 출제와 채점은 브라우저 안에서 끝납니다. 계정 기록만 Supabase에 남습니다.</dd>
          <dt>단일 정의</dt>
          <dd>같은 사실을 두 곳에 적지 않습니다. 시험 형식은 채점기가, 주제는 주제 파일이, 강조 표기는 렌더러 하나가 갖습니다. 두 곳에 두면 한쪽만 고쳐져 화면마다 다르게 읽힙니다.</dd>
          <dt>검산된 정답</dt>
          <dd>코드 출력 문항은 실제로 실행해 답을 맞춰 보고, 계산 문항은 수치를 다시 셉니다. 자동 채점은 표기 흔들림(대소문자·띄어쓰기·전각)을 정규화로 흡수합니다.</dd>
        </dl>

        <h2 class="group-title">읽기 전에</h2>
        <p class="about-caution">
          AI가 만든 콘텐츠라 오류가 있을 수 있습니다. <strong>학습 보조로만</strong> 쓰시고,
          시험을 앞두고는 공식 출제기준과 교재로 한 번 더 확인하세요.
          틀린 곳을 찾으면 <a href={`${REPO}/issues`} target="_blank" rel="noopener">이슈</a>로 알려 주시면 고치겠습니다.
        </p>

        <p class="about-foot">
          <a href={REPO} target="_blank" rel="noopener">GitHub 저장소</a> ·
          <a href={`${REPO}/blob/main/CHANGELOG.md`} target="_blank" rel="noopener">v{version} 변경 기록</a> ·
          <a href={BLOG} target="_blank" rel="noopener">daily.mcp 블로그 →</a>
        </p>
        </div>
      </section>
    </main>

    {/* 이메일 조립 — 평문으로 두면 봇이 긁어 간다. user/domain 을 합쳐 mailto 를 만든다.
        아이콘 링크라 텍스트는 덮어쓰지 않는다(svg 보존). 블로그 Footer.astro 와 같은 수법. */}
    <script>
      document.querySelectorAll<HTMLAnchorElement>(".about-mail:not([data-bound])").forEach((el) => {
        const { mailUser: user, mailDomain: domain } = el.dataset;
        if (!user || !domain) return;
        el.setAttribute("href", `mailto:${user}@${domain}`);
        if (!el.querySelector("*")) el.textContent = `${user}@${domain}`;
        el.setAttribute("data-bound", "");
      });
    </script>

    <SiteFooter />
  </body>
</html>
