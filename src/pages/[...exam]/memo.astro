---
import {
  AREAS_BY_EXAM,
  AREA_SLUGS,
  EXAM_FORMAT,
  EXAM_SLUGS,
  MEMO_EXAMS,
  examPath,
  memosOf,
  type Area,
  type Exam,
} from "../../content.config";
import { memoSearchText, topicNoteHref } from "../../lib/bank";
import MdBlocks from "../../components/MdBlocks.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

// 암기 노트 — 개념 노트가 "왜"를 읽는 자리라면 여기는 "무엇"만 외우는 자리다.
// 줄글 없이 두문자·표·목록으로 모은 카드를 영역 순으로 늘어놓고, 빨간 시트처럼
// 외울 값(값 칩·형광펜)을 가렸다가 하나씩 눌러 확인하는 가리기 모드를 둔다.
// 카드가 있는 시험만 라우트를 낸다(#92).
export function getStaticPaths() {
  return MEMO_EXAMS.map((exam) => ({ params: { exam: EXAM_SLUGS[exam] }, props: { exam } }));
}

const { exam } = Astro.props as { exam: Exam };
const px = examPath(exam);
const examLabel = EXAM_FORMAT[exam].label;
const cards = memosOf(exam);
// 영역 순서는 시험의 영역 정의를 따르고, 카드 순서는 JSON의 정의 순서를 따른다. 빈 영역은 내지 않는다.
const areas = (AREAS_BY_EXAM[exam] as readonly Area[])
  .map((area) => ({ area, slug: AREA_SLUGS[area], cards: cards.filter((c) => c.area === area) }))
  .filter((a) => a.cards.length > 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
/** 목차 펼침 화살표 — 열리면 90도 돈다(회전은 CSS가 맡는다). 개념 노트 목차와 같은 모양 */
const CARET =
  '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>';

// ── 두문자 조각내기 ──
// "물·데·네·전·세·표·응"처럼 ·로 바싹 붙은 짧은 음절은 외우는 실마리 그 자체라
// 글자 블록으로 하나씩 세운다. 반대로 "대칭 키 하나 · 비대칭 키 둘"처럼 ·가 구절을
// 가르는 자리에서 낱말을 블록으로 쪼개면 읽히지 않으므로 그냥 글로 둔다.
// 가르는 기준은 "붙어 있는가"와 "짧은가" 둘 — 공백 없는 ·로 이어진 한 덩어리에서
// 조각이 전부 세 글자 이하일 때만 블록이 된다("5만·50만·100만"은 100만이 길어 글로 남는다).
const MN_RUN = /[^\s·]+(?:·[^\s·]+)+/g;
const MN_SPACED = /^[^\s·]{1,3}(?: · [^\s·]{1,3})+$/;
type MnSeg = { block: boolean; text: string };
/** 블록 사이에 남는 글 — 양끝의 ·는 블록이 이미 자리로 말하는 구분이라 떼어 낸다
    (떼지 않으면 "A C I D · DDL …"처럼 앞에 점 하나가 떠 있는 꼴이 된다). "/"는 남긴다 */
const plain = (s: string) => s.replace(/^[\s·]+|[\s·]+$/g, "");
const mnemonicSegs = (mn: string): MnSeg[] => {
  // "지식 · 소유 · 존재 · 행동" — 띄어 쓴 ·로만 된 짧은 낱말 줄도 두문자로 본다
  if (MN_SPACED.test(mn)) return mn.split(" · ").map((t) => ({ block: true, text: t }));
  const out: MnSeg[] = [];
  let last = 0;
  for (const m of mn.matchAll(MN_RUN)) {
    const parts = m[0].split("·");
    if (parts.some((p) => [...p].length > 3)) continue;
    const lead = plain(mn.slice(last, m.index));
    if (lead) out.push({ block: false, text: lead });
    for (const p of parts) out.push({ block: true, text: p });
    last = m.index + m[0].length;
  }
  const tail = plain(mn.slice(last));
  if (tail) out.push({ block: false, text: tail });
  return out.length ? out : [{ block: false, text: mn }];
};
---

<!doctype html>
<html lang="ko" data-exam={EXAM_SLUGS[exam]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`daily.quiz — ${examLabel} 암기 노트`}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={`${examLabel} 필기·실기에서 그대로 외워야 하는 것만 두문자·표·목록으로 모은 암기 노트. 외울 값을 가렸다가 하나씩 확인합니다.`}
    />
  </head>
  <body>
    <SiteHeader current="memo" exam={exam} toc="영역" />

    <main class="side-layout memo-main">
      {/* 좌측 영역 목차 — 넓은 화면은 본문 옆에 고정, 좁은 화면은 헤더의 '영역' 버튼으로 여는 드로어.
          구조는 개념 노트의 목차와 같다(영역 줄 + 펼침 화살표 + 하위 목록) — 넓은 화면에선 제자리
          아코디언, 드로어에선 2단 판이 되고, 동작은 SiteHeader의 공통 스크립트가 맡는다. */}
      <aside id="side-toc" class="side-toc as-drawer" aria-label="영역 바로가기">
        <button id="toc-close" class="toc-close" type="button" aria-label="목차 닫기">×</button>
        {/* 카드 검색 — 한 시험의 카드가 마흔 장 넘게 한 페이지에 늘어서 있어,
            어느 영역에 있는지 모르는 카드는 눈으로 찾기 어렵다(제목·두문자·본문을 훑는다) */}
        <div class="side-search">
          <input
            id="toc-search"
            type="search"
            placeholder="카드 검색"
            aria-label="카드 검색"
            autocomplete="off"
          />
          <button id="toc-search-clear" class="side-search-clear" type="button" aria-label="검색어 지우기" hidden>×</button>
        </div>
        <span class="side-toc-title">영역</span>
        {/* 영역 줄은 목차 안에서 위아래로 붙어 고정된다 — 카드를 아무리 스크롤해도 영역 전환은
            항상 한 번에 닿는다(--i/--j는 그 줄이 쌓일 위·아래 칸 수). 여기엔 '전체' 줄이 없다 —
            모든 영역이 이 한 페이지에 서 있어 따로 갈 곳이 아니다. */}
        {areas.map(({ area, slug, cards: cs }, k) => (
          <Fragment>
            <div class="side-row" data-row={slug} style={`--i: ${k}; --j: ${areas.length - 1 - k}`}>
              <button
                class="side-caret"
                type="button"
                aria-expanded={k === 0 ? "true" : "false"}
                aria-controls={`sub-${slug}`}
                aria-label={`${area} 카드 목록`}
              >
                <Fragment set:html={CARET} />
              </button>
              <a class="side-link memo-side" href={`#${slug}`} data-area={slug}>
                <span class="side-label">{area}</span> <em>{cs.length}</em>
              </a>
            </div>
            <div class={`side-sub-wrap${k === 0 ? " open" : ""}`} id={`sub-${slug}`}>
              {/* 드로어 2단에서만 보이는 뒤로가기 — 넓은 화면에선 display:none이라 아코디언 격자에서 빠진다 */}
              <button class="side-back" type="button">← {area}</button>
              <nav class="side-sub" aria-label={`${area} 카드`}>
                {cs.map((c) => (
                  <a class="side-sublink" href={`#m-${c.key}`} title={c.title} data-search={memoSearchText(c)}>{c.title}</a>
                ))}
              </nav>
            </div>
          </Fragment>
        ))}
        <p class="side-empty" hidden>찾는 카드가 없습니다</p>
      </aside>

      <div class="side-body reading">
        <section class="panel">
          <h1>{examLabel} 암기 노트</h1>
          <p class="lead">
            그대로 외워야 하는 것만 모았습니다 — 두문자 · 표 · 한 줄 목록. 설명은
            <a class="lead-link" href={`${base}${px}/notes/`}>개념 노트</a>에 있습니다.
            <strong>가리기</strong>를 켜면 외울 값이 가려지고, 눌러서 하나씩 확인합니다.
          </p>
          {/* 좁은 화면 전용 — 영역 이동 칩 */}
          <nav class="toc" aria-label="영역 이동">
            {areas.map(({ area, slug, cards: cs }) => (
              <a class="toc-chip" href={`#${slug}`}>{area} <em>{cs.length}</em></a>
            ))}
          </nav>
          <div class="note-tools memo-tools">
            <button id="cover-toggle" class="ghost" type="button" aria-pressed="false">가리기 켜기</button>
            <span class="memo-tool-right">
              <button id="hide-done" class="linklike" type="button" aria-pressed="false">외운 것 숨기기</button>
              <button id="cover-reset" class="linklike" type="button" hidden>모두 다시 가리기</button>
            </span>
          </div>
          {/* 진행 — 쉰 장 넘는 카드 중 어디까지 봤는지가 남지 않았다(#92) */}
          <p class="memo-prog"><span id="prog-bar"><i id="prog-fill"></i></span><span id="prog-text"></span>
            <button id="prog-reset" class="linklike" type="button" hidden>기록 지우기</button>
          </p>
        </section>

        <section class="panel">
          {areas.map(({ area, slug, cards: cs }) => (
            <section class="memo-area" id={slug}>
              {/* 종이에는 영역 이름만 — 개수는 종이 밖에 둔다(쪽지에 적은 제목과 세어 놓은 수는
                  다른 물건이다) */}
              <h2 class="memo-area-title">
                <span class="area-paper">{area}</span>
                {/* 개수가 아니라 진행이다 — 외운 수가 앞, 전체가 뒤(스크립트가 앞 숫자를 채운다) */}
                <em class="area-prog" data-total={cs.length}><b>0</b>/{cs.length}</em>
              </h2>
              {cs.map((c) => (
                <article class="memo" id={`m-${c.key}`}>
                  <h3 class="memo-title">
                    <span class="memo-name">{c.title}</span>
                    {/* 두문자 — 외우는 실마리라 가리기 모드에서도 남긴다 */}
                    {c.mnemonic && (
                      <span class="memo-mn">
                        {mnemonicSegs(c.mnemonic).map((seg) =>
                          seg.block ? <b class="mn-s">{seg.text}</b> : <span class="mn-t">{seg.text}</span>,
                        )}
                      </span>
                    )}
                    {/* 이 카드가 요약하는 개념 주제 — 설명이 필요할 때 가는 곳.
                        주소를 내는 규칙은 bank.ts가 갖는다(마이페이지도 같은 길을 쓴다). */}
                    {topicNoteHref(c.topic) && (
                      <a class="memo-src" href={topicNoteHref(c.topic)} title={c.topicTitle}>개념 →</a>
                    )}
                    {/* 외웠다 — 채점이 아니라 자기 선언이다(문항이 없으니 기계가 가릴 수 없다) */}
                    <button class="memo-done-btn" type="button" aria-pressed="false" aria-label="외웠다고 표시">
                      <span class="mdb-mark" aria-hidden="true">✓</span><span class="mdb-text">외웠다</span>
                    </button>
                  </h3>
                  {/* 본문은 개념 도입부와 같은 렌더러·같은 글꼴 체계(.topic-intro)를 쓴다 */}
                  <div class="topic-intro memo-body">
                    <MdBlocks text={c.body} memo />
                  </div>
                </article>
              ))}
            </section>
          ))}
          <nav class="area-nav">
            <a href={`${base}${px}/notes/`}><small>개념 노트</small>← 설명이 필요하면</a>
            <a class="next" href={`${base}${px}/`}><small>필기 문제</small>외웠으면 풀어 보기 →</a>
          </nav>
        </section>
      </div>
    </main>

    <script>
      // ── 외운 카드 기록 ──
      // 채점이 아니라 자기 선언이다. 카드마다 토글 하나, 영역 머리글에 "외운 수/전체",
      // 맨 위에 전체 진행과 "외운 것 숨기기". 기기에만 남고 시험별로 갈린다(오답노트와 같은 규약).
      {
        const { doneKey, loadDone, saveDone } = await import("../../lib/memo-done");
        const KEY = doneKey(document.documentElement.dataset.exam ?? "");
        const cards = [...document.querySelectorAll<HTMLElement>(".memo")];
        const hideBtn = document.getElementById("hide-done") as HTMLButtonElement;
        const fill = document.getElementById("prog-fill") as HTMLElement;
        const text = document.getElementById("prog-text") as HTMLElement;
        const resetBtn = document.getElementById("prog-reset") as HTMLButtonElement;
        let done = loadDone(KEY);
        let hiding = false;

        const paint = () => {
          cards.forEach((card) => {
            const on = done.has(card.id);
            card.classList.toggle("done", on);
            // 숨기는 중에도 지금 막 외운 카드는 남긴다 — 누르자마자 사라지면 잘못 눌렀을 때 되돌릴 길이 없다
            card.hidden = hiding && on && card.dataset.keep !== "1";
            const b = card.querySelector<HTMLButtonElement>(".memo-done-btn");
            b?.setAttribute("aria-pressed", String(on));
            if (b) b.querySelector<HTMLElement>(".mdb-text")!.textContent = on ? "외움" : "외웠다";
          });
          // 목차도 함께 접는다 — 숨긴 카드를 목차가 계속 가리키면 눌러도 아무 데도 가지 않는다
          cards.forEach((card) => {
            const a = document.querySelector<HTMLElement>(`.side-sublink[href="#${card.id}"]`);
            if (a) a.hidden = card.hidden;
          });
          // 영역별 진행 — 그 영역에서 외운 수
          document.querySelectorAll<HTMLElement>(".memo-area").forEach((sec) => {
            const n = [...sec.querySelectorAll<HTMLElement>(".memo")].filter((c) => done.has(c.id)).length;
            sec.querySelector<HTMLElement>(".area-prog b")!.textContent = String(n);
            // 한 영역을 다 외우면 영역 자체도 접힌다 — 숨기기를 켠 뜻이 "남은 것만 보자"이므로
            sec.hidden = hiding && ![...sec.querySelectorAll<HTMLElement>(".memo")].some((c) => !c.hidden);
            // 통째로 접힌 영역은 목차에서도 줄과 판을 함께 뺀다
            const row = document.querySelector<HTMLElement>(`.side-row[data-row="${sec.id}"]`);
            if (row) row.hidden = sec.hidden;
            const wrap = document.getElementById(`sub-${sec.id}`);
            if (wrap) wrap.hidden = sec.hidden;
          });
          const n = cards.filter((c) => done.has(c.id)).length;
          fill.style.width = `${Math.round((n / cards.length) * 100)}%`;
          text.textContent = `${n} / ${cards.length}장 외움`;
          resetBtn.hidden = n === 0;
          hideBtn.hidden = n === 0;
        };

        cards.forEach((card) => {
          card.querySelector<HTMLButtonElement>(".memo-done-btn")?.addEventListener("click", () => {
            if (done.has(card.id)) done.delete(card.id);
            else done.add(card.id);
            card.dataset.keep = "1"; // 이번 칠에는 안 숨긴다
            saveDone(KEY, done);
            paint();
          });
        });
        hideBtn.addEventListener("click", () => {
          hiding = !hiding;
          hideBtn.setAttribute("aria-pressed", String(hiding));
          hideBtn.textContent = hiding ? "외운 것도 보기" : "외운 것 숨기기";
          cards.forEach((c) => delete c.dataset.keep); // 다시 칠할 때는 예외를 걷는다
          paint();
        });
        resetBtn.addEventListener("click", () => {
          if (!confirm("외운 표시를 모두 지웁니다. 되돌릴 수 없습니다.")) return;
          done = new Set();
          saveDone(KEY, done);
          paint();
        });
        paint();
      }

      // ── 가리기 모드(빨간 시트) ──
      // 외울 값(.val)과 형광펜(.hl)을 덮고, 누르면 그것만 드러난다. 다시 누르면 다시 덮인다.
      // 상태는 기기에 남긴다 — 외우는 중에 페이지를 오가도 시트가 벗겨지지 않게.
      const KEY = "daily.quiz.memo-cover";
      const main = document.querySelector<HTMLElement>(".memo-main")!;
      const toggle = document.getElementById("cover-toggle") as HTMLButtonElement;
      const reset = document.getElementById("cover-reset") as HTMLButtonElement;
      const targets = [...document.querySelectorAll<HTMLElement>(".memo-body .hl, .memo-body .val")]
        // 형광펜 안의 값 칩은 형광펜이 통째로 덮는다 — 안쪽까지 따로 덮으면 두 겹이 된다
        .filter((el) => !(el.classList.contains("val") && el.closest(".hl")));

      const setCover = (on: boolean) => {
        main.classList.toggle("cover", on);
        toggle.textContent = on ? "가리기 끄기" : "가리기 켜기";
        toggle.setAttribute("aria-pressed", String(on));
        reset.hidden = !on;
        targets.forEach((el) => {
          el.classList.remove("peek");
          if (on) {
            el.setAttribute("role", "button");
            el.setAttribute("tabindex", "0");
            el.setAttribute("aria-label", "가려진 값 — 눌러서 확인");
          } else {
            el.removeAttribute("role");
            el.removeAttribute("tabindex");
            el.removeAttribute("aria-label");
          }
        });
        try {
          localStorage.setItem(KEY, on ? "1" : "0");
        } catch {
          /* 저장 불가 환경이면 이 페이지에서만 */
        }
      };
      toggle.addEventListener("click", () => setCover(!main.classList.contains("cover")));
      reset.addEventListener("click", () => targets.forEach((el) => el.classList.remove("peek")));
      const peek = (el: HTMLElement) => {
        if (main.classList.contains("cover")) el.classList.toggle("peek");
      };
      targets.forEach((el) => {
        el.addEventListener("click", () => peek(el));
        el.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            peek(el);
          }
        });
      });
      try {
        if (localStorage.getItem(KEY) === "1") setCover(true);
      } catch {
        /* ignore */
      }

      // ── 사이드 목차 ──
      // 판을 여는 길은 둘이고, 둘 다 사용자가 누른 결과다 — 개념 노트와 같은 약속이다.
      //   화살표  그 자리에서 펼친다(옮겨 가지 않고 다른 영역을 들춰 본다)
      //   영역 줄  그 영역으로 가면서 그 영역의 카드 목록을 연다
      // 뒤엣것이 개념 노트에선 '다른 페이지로 이동 → 그 영역의 판이 열린 채로 뜸'으로 이뤄진다.
      // 여기선 한 페이지라 이동이 앵커 점프가 되는데, 그러면서 '열린 채로'가 빠져 있었다.
      //
      // 스크롤로는 열지 않는다. 한때 읽는 자리를 따라 판까지 옮겨 열었더니, 목차에서 카드를
      // 고르면 그 자리까지 부드럽게 스크롤하는 동안 지나치는 영역마다 판이 차례로 열렸다 닫혀
      // 목차가 요동쳤다 — 목차가 스스로 일으킨 스크롤에 목차가 반응한 꼴이다.
      const rows = [...document.querySelectorAll<HTMLElement>(".side-toc .side-row")];
      const caretBtns = [...document.querySelectorAll<HTMLButtonElement>(".side-toc .side-caret")];
      const wraps = [...document.querySelectorAll<HTMLElement>(".side-toc .side-sub-wrap")];
      // 공통 스크립트(SiteHeader)의 openPane과 같은 일 — 상태는 DOM에만 있어 서로 어긋나지 않는다
      const openArea = (i: number) => {
        caretBtns.forEach((c, k) => c.setAttribute("aria-expanded", String(k === i)));
        wraps.forEach((w, k) => w.classList.toggle("open", k === i));
      };
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".memo-side")];
      const sections = links.map((a) => document.getElementById(a.dataset.area!)!);
      // 영역 줄을 누르면 그 영역의 카드 목록이 열린 채로 남는다(개념 노트에서 그 영역 페이지로
      // 건너갔을 때와 같은 자리). 이동 자체는 앵커가 맡으므로 여기서는 펼치기만 한다.
      links.forEach((a, i) => a.addEventListener("click", () => openArea(i)));
      const subLinks = [...document.querySelectorAll<HTMLAnchorElement>(".side-sublink")];
      // 카드 목록은 위 블록(외운 카드 기록) 안에 갇혀 있어 여기서 다시 집는다
      const memoCards = [...document.querySelectorAll<HTMLElement>(".memo")];
      // 여기엔 '되돌릴 판'(data-current)을 두지 않는다. 개념 노트에선 페이지가 곧 영역이라
      // 되돌릴 자리가 분명하지만, 한 페이지에 모든 영역이 선 여기서는 그런 자리가 없다 —
      // 처음 영역에 붙박으면 드로어에서 카드를 고를 때마다 그 판이 열렸고, 읽는 자리를 따라
      // 옮기면 부드럽게 스크롤하는 도중의 영역을 집었다. 드로어는 열 때 어차피 판을 다 닫으므로,
      // 닫을 때도 다 닫힌 채로 두는 것이 앞뒤가 맞는다.

      // 기준선 — 앵커로 뛰었을 때 카드가 실제로 내려앉는 높이다.
      // 브라우저는 html의 scroll-padding-top과 대상의 scroll-margin-top을 더한 만큼 띄우므로,
      // 그 합보다 선이 위에 있으면 방금 뛴 카드가 선을 못 넘어 바로 앞 카드가 '지금 읽는 것'이 된다.
      const px = (v: string) => parseFloat(v) || 0;
      const line =
        px(getComputedStyle(document.documentElement).scrollPaddingTop) +
        px(getComputedStyle(memoCards[0]).scrollMarginTop) +
        8;

      let at = -1;
      let cardAt: string | null = null;
      const spy = () => {
        let cur = 0;
        sections.forEach((s, i) => {
          if (!s.hidden && s.getBoundingClientRect().top <= line) cur = i;
        });
        if (cur !== at) {
          at = cur;
          rows.forEach((r, i) => r.classList.toggle("on", i === cur));
          links.forEach((a, i) => a.classList.toggle("on", i === cur));
        }
        // 카드 단위 — 지금 영역 **안에서** 짚는다. 전체에서 고르면 영역 어귀에 섰을 때
        // 아직 이 영역의 첫 카드가 선을 넘기 전이라 앞 영역의 마지막 카드가 잡히는데,
        // 줄에는 이미 이 영역이 켜져 있어 둘이 서로 어긋나 보인다.
        const inArea = [...sections[cur].querySelectorAll<HTMLElement>(".memo")].filter((c) => !c.hidden);
        let el: HTMLElement | null = inArea[0] ?? null;
        for (const card of inArea) {
          if (card.getBoundingClientRect().top <= line) el = card;
        }
        const id = el?.id ?? null;
        if (id === cardAt) return;
        cardAt = id;
        subLinks.forEach((a) => a.classList.toggle("on", a.getAttribute("href")!.slice(1) === id));
      };
      let ticking = false;
      document.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            ticking = false;
            spy();
          });
        },
        { passive: true },
      );
      spy();
    </script>

    <SiteFooter />
  </body>
</html>
