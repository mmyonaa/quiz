---
import {
  AREAS_BY_EXAM,
  AREA_SLUGS,
  EXAMS,
  EXAM_FORMAT,
  EXAM_SLUGS,
  SUBJECTS_BY_EXAM,
  SUBJECT_SLUGS,
  examPath,
  type Exam,
} from "../../../content.config";
import { loadBank, loadPractical, topicsOf, topicsOfSubject, areasOfSubject } from "../../../lib/bank";
import SiteHeader from "../../../components/SiteHeader.astro";
import SiteFooter from "../../../components/SiteFooter.astro";
import "../../../styles/global.css";

// 개념 노트 목차 — 영역별 상세 페이지(/notes/<slug>/)로 이어지는 관문.
// 본문이 계속 늘어나므로 한 페이지에 다 싣지 않고 영역 단위로 라우팅을 나눈다.
//
// 시험마다 한 벌씩 낸다. 정처기는 접두어 없이 /notes/ 로(기존 URL 유지),
// 정보보안기사는 /sec/notes/ 로 나간다 — rest 파라미터가 undefined면 그 segment가 사라진다.
export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam: EXAM_SLUGS[exam] }, props: { exam } }));
}

const { exam } = Astro.props as { exam: Exam };
const px = examPath(exam);
const examLabel = EXAM_FORMAT[exam].label;

// 문항은 아직 정처기에만 있다. 시험으로 걸러 두면 정보보안기사는 0으로 나오고,
// 문항이 붙는 순간(#29·#32) 별도 수정 없이 숫자가 채워진다.
const bank = (await loadBank()).filter((q) => q.exam === exam);
// 실기 문항도 같은 주제에 붙으므로 어느 영역·과목에 몇 개가 붙어 있는지 함께 보여준다
const pbank = (await loadPractical()).filter((q) => q.exam === exam);

const areas = AREAS_BY_EXAM[exam].map((area) => {
  const topics = topicsOf(area, exam);
  return {
    area,
    slug: AREA_SLUGS[area],
    count: bank.filter((q) => q.area === area).length,
    practicalCount: pbank.filter((q) => q.area === area).length,
    topicCount: topics.length,
    preview: topics.slice(0, 3).map((t) => t.title),
  };
});

// 시험 과목 — 영역보다 한 단계 위. 과목과 영역은 다대다라 과목 안에 걸친 영역을 함께 보여준다.
const subjects = SUBJECTS_BY_EXAM[exam].map((subject, i) => ({
  subject,
  no: i + 1,
  slug: SUBJECT_SLUGS[subject],
  count: bank.filter((q) => q.subject === subject).length,
  practicalCount: pbank.filter((q) => q.subject === subject).length,
  topics: topicsOfSubject(subject, exam),
  areas: areasOfSubject(subject, exam),
}));

const topicCount = areas.reduce((n, a) => n + a.topicCount, 0);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ko" data-exam={EXAM_SLUGS[exam]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{`daily.quiz — ${examLabel} 개념 노트`}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={`${examLabel} 개념을 영역별·과목별로 모아 읽는 개념 노트. 각 개념은 확인 문제와 daily.mcp 개념 글로 이어집니다.`}
    />
  </head>
  <body>
    <SiteHeader current="notes" exam={exam} />

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 영역 메뉴. 목차 페이지에서는 '전체'가 현재 위치 */}
      <aside class="side-toc" aria-label="영역 바로가기">
        <span class="side-toc-title">영역</span>
        {/* 문항이 아직 없는 시험에서는 세는 단위가 주제다 — 0만 늘어선 목차는 아무것도 알려 주지 않는다 */}
        <a class="side-link on" href={`${base}${px}/notes/`}>전체 <em>{bank.length > 0 ? bank.length : topicCount}</em></a>
        {areas.map(({ area, slug, count, topicCount: n }) => (
          <a class="side-link" href={`${base}${px}/notes/${slug}/`}>{area} <em>{bank.length > 0 ? count : n}</em></a>
        ))}
      </aside>

      <div class="side-body">
        <section class="panel">
          <h1>{examLabel} 개념 노트</h1>
          <p class="lead">
            {bank.length > 0
              ? `문제 은행 ${bank.length}문항의 해설을 개념별로 모았습니다.`
              : `${topicCount}개 주제의 개념을 모았습니다.`}
            실제 시험 과목으로 훑거나, 아래 영역으로 들어가 읽다가 '확인 문제'를 펼쳐
            스스로 점검하고, 더 깊게는 개념 글로 이어가세요.
            {/* 실기는 아직 정처기에만 있다 — 없는 시험에서 죽은 링크를 내보내지 않는다 */}
            {pbank.length > 0 && (
              <>
                개념은 필기·실기를 나누지 않습니다 — 같은 주제 아래
                <a class="lead-link" href={`${base}${px}/practical/`}>실기 확인 문제</a> {pbank.length}개가 함께 붙어 있습니다.
              </>
            )}
          </p>

          {/* 시험 과목 — 실제 필기의 5과목. 영역보다 한 단계 위 */}
          <h2 class="group-title">시험 과목</h2>
          <div class="subject-cards">
            {subjects.map(({ subject, no, slug, count, practicalCount, topics, areas: sAreas }) => (
              <a class="subject-card" href={`${base}${px}/notes/s/${slug}/`}>
                <h3><span class="subj-no">{no}과목</span> {subject} <em>{count > 0 ? `${count}문항` : `${topics.length}주제`}</em></h3>
                <p class="ac-meta">
                  {/* 헤드라인이 이미 주제 수를 말하는 경우(문항 0)에는 되풀이하지 않는다 */}
                  {count > 0 && <>{topics.length}개 주제 · </>}
                  {practicalCount > 0 && <><span class="ac-pa">실기 {practicalCount}문항</span> · </>}
                  {sAreas.join(" · ")}
                </p>
              </a>
            ))}
          </div>

          <h2 class="group-title">영역</h2>
          <div class="area-cards">
            {areas.map(({ area, slug, count, practicalCount, topicCount, preview }) => (
              <a class="area-card" href={`${base}${px}/notes/${slug}/`}>
                <h2>{area} <em>{count > 0 ? `${count}문항` : `${topicCount}주제`}</em></h2>
                <p class="ac-meta">
                  {count > 0 && <>{topicCount}개 주제</>}
                  {practicalCount > 0 && <> · <span class="ac-pa">실기 {practicalCount}문항</span></>}
                  {preview.length > 0 &&
                    `${count > 0 ? " — " : ""}${preview.join(" · ")}${topicCount > preview.length ? " …" : ""}`}
                </p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>

    {/* 예전 단일 페이지 시절의 #영역 앵커 링크 호환 — 영역 상세로 보낸다 */}
    <script is:inline define:vars={{ slugMap: AREA_SLUGS, base, px }}>
      const area = decodeURIComponent(location.hash.slice(1));
      if (slugMap[area]) location.replace(`${base}${px}/notes/${slugMap[area]}/`);
    </script>

    <SiteFooter />
  </body>
</html>
