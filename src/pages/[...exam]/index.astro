---
import { AREA_SLUGS, DIFFICULTIES, EXAMS, EXAM_FORMAT, EXAM_SLUGS, examPath, type Exam } from "../../content.config";
import { areasOf, loadBank, subjectsOf } from "../../lib/bank";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

// 한 벌의 파일이 시험 수만큼 라우트를 낸다 — 정처기는 `/`, 정보보안기사는 `/sec/`.
// 개념 노트·실기와 같은 방식이다(중간 위치 rest 파라미터, params.exam이 undefined면 접두어가 없다).
export function getStaticPaths() {
  return EXAMS.map((exam) => ({ params: { exam: EXAM_SLUGS[exam] }, props: { exam } }));
}
const { exam } = Astro.props as { exam: Exam };
const px = examPath(exam);
const format = EXAM_FORMAT[exam];

// 문제 은행 전체를 빌드 타임에 굽는다 — 서버 없이 클라이언트 JS만으로 동작.
// 은행은 두 시험이 공유하므로 반드시 이 화면의 시험으로 걸러야 한다.
const bank = (await loadBank()).filter((q) => q.exam === exam);
const SUBJECTS = subjectsOf(exam);
const AREAS = areasOf(exam);
const countBySubject = Object.fromEntries(
  SUBJECTS.map((s) => [s, bank.filter((q) => q.subject === s).length]),
);
const countByArea = Object.fromEntries(
  AREAS.map((a) => [a, bank.filter((q) => q.area === a).length]),
);
const countByDiff = Object.fromEntries(
  DIFFICULTIES.map((d) => [d, bank.filter((q) => q.difficulty === d).length]),
);
// 모의고사 편성 — 과목당 문항 수는 시험 형식에서 온다
const mockTotal = format.written.perSubject * SUBJECTS.length;

// 오답 리뷰의 "관련 글" 링크 — daily.mcp 블로그의 글 상세 URL
const BLOG_POST_BASE = "https://mmyonaa.github.io/blog/blog/";

// 결과 화면의 약점 CTA가 영역별 개념 노트로 잇는다 — URL은 한글을 피해 영문 슬러그를 쓴다
const NOTES_BASE = `${import.meta.env.BASE_URL.replace(/\/$/, "")}${px}/notes/`;
const AREA_SLUG_MAP = Object.fromEntries(AREAS.map((a) => [a, AREA_SLUGS[a]]));
---

<!doctype html>
<html lang="ko" data-exam={EXAM_SLUGS[exam]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — {format.label} 필기 개념 문제</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={`${format.label} 필기 빈출 개념을 4지선다로 풀고, 즉시 채점과 오답 해설을 받는 연습장. daily.mcp 블로그의 개념 글과 연결됩니다.`}
    />
  </head>
  <body>
    <SiteHeader current="quiz" exam={exam} />

    <main>
      {/* ── 1. 설정 화면 ── */}
      <section id="setup" class="panel">
        <h1>{exam} 필기 연습</h1>
        <p class="lead">
          문제를 섞어 출제하고 바로 채점합니다. 틀린 문제는 해설과 함께
          <a class="lead-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${px}/notes/`}>개념 노트</a>로 이어집니다.
        </p>

        {/* 중단된 풀이 — 있으면 무엇보다 먼저 잡아야 할 일이라 카드 위에 둔다 */}
        <div id="resume-box" class="note-box resume" hidden>
          <span id="resume-info"></span>
          <span class="note-actions">
            <button id="resume-go" class="ghost">이어서 풀기</button>
            <button id="resume-drop" class="linklike">버리기</button>
          </span>
        </div>

        {/* 무엇을 할지부터 고른다 — 조건은 고른 뒤에 (#44) */}
        <div class="mode-cards">
          <section class="mode-card">
            <h2>빠른 연습</h2>
            <p class="mode-desc" id="quick-summary"></p>
            <button id="start" class="primary">시작하기</button>
            <details class="opts">
              <summary>조건 바꾸기</summary>
            <fieldset class="areas">
              <legend>시험 과목</legend>
              <label class="area-opt">
                <input type="radio" name="scope" value="전체" checked />
                <span>전체 <em>{bank.length}</em></span>
              </label>
              {SUBJECTS.map((s, i) => (
                <label class="area-opt">
                  <input type="radio" name="scope" value={`과목:${s}`} />
                  <span>{i + 1}과목 {s} <em>{countBySubject[s]}</em></span>
                </label>
              ))}
            </fieldset>
            <fieldset class="areas">
              <legend>영역</legend>
              {AREAS.map((a) => (
                <label class="area-opt">
                  <input type="radio" name="scope" value={`영역:${a}`} />
                  <span>{a} <em>{countByArea[a]}</em></span>
                </label>
              ))}
            </fieldset>
            <fieldset class="diffs">
              <legend>난이도</legend>
              <label class="area-opt">
                <input type="radio" name="diff" value="전체" checked />
                <span>전체</span>
              </label>
              {DIFFICULTIES.map((d) => (
                <label class="area-opt">
                  <input type="radio" name="diff" value={d} />
                  <span>{d} <em>{countByDiff[d]}</em></span>
                </label>
              ))}
            </fieldset>
            <fieldset class="counts">
              <legend>문제 수</legend>
              {[5, 10, 15].map((n, i) => (
                <label class="area-opt">
                  <input type="radio" name="count" value={n} checked={i === 1} />
                  <span>{n}문제</span>
                </label>
              ))}
            </fieldset>
            <fieldset class="counts">
              <legend>채점 방식</legend>
              <label class="area-opt">
                <input type="radio" name="grade" value="after" checked />
                <span>제출 후 한꺼번에</span>
              </label>
              <label class="area-opt">
                <input type="radio" name="grade" value="instant" />
                <span>고르면 바로 확인</span>
              </label>
            </fieldset>
            </details>
          </section>

          <section class="mode-card">
            <h2>모의고사</h2>
            <p class="mode-desc">
              {SUBJECTS.length}과목 × {format.written.perSubject}문항 · 총 {mockTotal}문항 · {format.written.minutes}분<br />
              과목별 {format.written.subjectPass}점 미만 과락, 과락 없이 평균 {format.written.averagePass}점이면 합격.
              실제 OMR처럼 답안 표기란에 마킹하며 문항을 건너뛸 수 있습니다.
            </p>
            <button id="start-mock" class="primary">모의고사 시작</button>
          </section>

          {/* 오답 복습 — 비어 있어도 카드는 남긴다. 여기가 무엇을 담는 자리인지 말해야 한다 */}
          <section class="mode-card" id="note-box">
            <h2>오답 복습</h2>
            <p class="mode-desc" id="note-info"></p>
            <span class="mode-actions">
              <button id="start-note" class="primary">오답만 다시 풀기</button>
              <button id="note-clear" class="linklike">비우기</button>
            </span>
          </section>
        </div>
      </section>

      {/* ── 2. 풀이 화면 ── */}
      <section id="exam" class="panel" hidden>
        <div class="exam-cols">
          <div class="exam-main">
            <div class="exam-top">
              <div class="exam-head">
                <span id="progress" class="mono"></span>
                <span id="timer" class="mono timer" hidden></span>
                <span class="exam-tools">
                  <button id="save-q" class="save-star" type="button" title="이 문제 저장" aria-label="이 문제 저장">☆</button>
                  <span id="exam-diff" class="badge diff"></span>
                  <span id="exam-area" class="badge"></span>
                </span>
              </div>
              <div id="pbar" class="pbar" role="progressbar" aria-label="풀이 진행률" aria-valuemin="0" aria-valuemax="100"><i id="pbar-fill"></i></div>
            </div>
            <div id="q-body">
              <h2 id="q-text" tabindex="-1"></h2>
              <pre id="q-code" class="q-code mono" hidden></pre>
              <ol id="q-choices" class="choices"></ol>
              <div id="q-feedback" class="q-feedback" hidden></div>
            </div>
            <div class="exam-nav">
              <button id="quit" class="linklike quit">그만두고 나가기</button>
              <button id="prev" class="ghost" disabled>이전</button>
              <button id="next" class="primary" disabled>다음</button>
            </div>
            <p class="kbd-hint"><kbd>1</kbd>–<kbd>4</kbd> 선택 · <kbd>←</kbd> <kbd>→</kbd> 이동 · <kbd>Enter</kbd> 다음</p>
          </div>

          {/* 모의고사 전용 답안지 — 실제 OMR처럼 문항별 ①~④를 마킹하고, 번호로 곧장 이동한다 */}
          <details id="omr" class="omr" hidden>
            <summary class="omr-head">
              <span class="omr-title">답안 표기란</span>
              <span id="omr-count" class="mono omr-count"></span>
            </summary>
            <div class="omr-legend" aria-hidden="true">
              <span><i class="omr-dot marked"></i> 표기</span>
              <span><i class="omr-dot"></i> 미표기</span>
            </div>
            <div id="omr-sheet" class="omr-sheet"></div>
            <p class="omr-hint">번호를 누르면 그 문항으로 이동하고, ①~④를 누르면 바로 표기됩니다.</p>
          </details>
        </div>
      </section>

      {/* ── 3. 결과 화면 ── */}
      <section id="result" class="panel" hidden>
        <h1 id="score" tabindex="-1"></h1>
        <div class="score-bar"><i id="score-fill"></i></div>
        <p id="elapsed" class="elapsed"></p>
        <p id="verdict" class="lead"></p>
        <div id="subjects" class="subjects" hidden></div>
        <div id="weak-cta" class="weak-cta" hidden></div>
        <div id="review-tools" class="review-tools" hidden>
          <button id="only-wrong" class="toc-chip" type="button" aria-pressed="false">틀린 문제만 보기</button>
        </div>
        <div id="review"></div>
        <p id="note-status" class="note-status"></p>
        <div class="exam-nav">
          <button id="retry-note" class="ghost" hidden>오답만 다시 풀기</button>
          <button id="retry" class="primary">다시 풀기</button>
        </div>
      </section>
    </main>

    <SiteFooter />

    {/* 문제 은행 주입 — 빌드 타임 데이터, 런타임 요청 없음 */}
    <script is:inline type="application/json" id="bank" set:html={JSON.stringify(bank)} />
    <script is:inline type="application/json" id="config" set:html={JSON.stringify({ blogPostBase: BLOG_POST_BASE, areas: AREAS, subjects: SUBJECTS, areaSlugs: AREA_SLUG_MAP, notesBase: NOTES_BASE, examSlug: EXAM_SLUGS[exam] ?? "", written: format.written })} />

    <script>
      type Q = {
        id: string;
        area: string;
        subject: string;
        difficulty: string;
        question: string;
        code?: string; // 코드 해석 문항의 코드 블록
        choices: string[];
        answer: number;
        explanation: string;
        relatedPost?: string; // 선택 — 글이 아직 없는 문항은 해설로 완결
      };

      import { supabase } from "../../lib/supabase";
      import { onAuth, authSession, requireLogin, errorText } from "../../lib/auth";
      import { toast } from "../../lib/toast";
      import {
        dueIds,
        loadNote,
        markRight,
        markWrong,
        noteKey,
        saveNote,
        type Note,
      } from "../../lib/wrong-note";

      const bank: Q[] = JSON.parse(document.getElementById("bank")!.textContent!);
      const { blogPostBase, subjects: SUBJECT_LIST, areas: AREA_LIST, areaSlugs, notesBase, examSlug, written } = JSON.parse(document.getElementById("config")!.textContent!) as {
        blogPostBase: string;
        subjects: string[];
        areas: string[];
        areaSlugs: Record<string, string>; // 영역 → 개념 노트 URL 슬러그
        notesBase: string;
        examSlug: string; // 정처기는 "" — 기존 저장 키를 그대로 쓴다
        written: { perSubject: number; minutes: number; subjectPass: number; averagePass: number };
      };

      // 저장 키는 시험별로 갈라야 한다 — 오답노트를 한 통에 두면 이 화면의 은행에 없는 id가
      // 불러오는 순간 걸러지고 그대로 다시 저장돼 다른 시험의 기록이 지워진다.
      // 정처기는 접미어가 없어 기존 사용자의 저장분이 그대로 이어진다.
      const keyOf = (base: string) => (examSlug ? `${base}.${examSlug}` : base);

      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;
      // innerHTML 템플릿에 끼워 넣는 코드 블록용 — C 코드의 <, & 등이 태그로 해석되지 않게
      const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
      const setup = $("#setup"), exam = $("#exam"), result = $("#result");

      let session: Q[] = [];
      let picked: number[] = []; // 문항별 사용자 선택
      let cur = 0;
      let mode: "practice" | "mock" = "practice";
      // 채점 방식 — 연습에서만 갈린다. 고른 순간 정오와 해설을 펴거나(instant),
      // 지금까지처럼 제출할 때 한꺼번에 채점한다. 모의고사는 실제 시험 재현이라 늘 후자다.
      let instant = false;

      // ── 타이머 — 모의고사는 제한 시간 카운트다운, 연습은 경과 시간 카운트업 ──
      // 시험 형식(EXAM_FORMAT[exam].written)에서 온다 — 상수로 박아 두면 시험이 늘 때마다 물린다.
      const MOCK_MINUTES = written.minutes;
      const MOCK_PER_SUBJECT = written.perSubject;
      let startedAt = 0;
      let deadline = 0;
      let timerId: ReturnType<typeof setInterval> | undefined;

      const pad = (n: number) => String(n).padStart(2, "0");
      const fmtClock = (s: number) =>
        s >= 3600
          ? `${Math.floor(s / 3600)}:${pad(Math.floor((s % 3600) / 60))}:${pad(s % 60)}`
          : `${Math.floor(s / 60)}:${pad(s % 60)}`;
      const fmtDuration = (s: number) => {
        const h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        return h > 0 ? `${h}시간 ${m}분 ${sec}초` : m > 0 ? `${m}분 ${sec}초` : `${sec}초`;
      };

      const stopTimer = () => {
        if (timerId !== undefined) clearInterval(timerId);
        timerId = undefined;
        $("#timer").hidden = true;
      };
      const tickTimer = () => {
        if (mode === "mock") {
          const left = Math.max(0, deadline - Date.now());
          $("#timer").textContent = fmtClock(Math.ceil(left / 1000));
          $("#timer").classList.toggle("low", left <= 10 * 60 * 1000); // 10분 남으면 경고
          if (left <= 0) {
            stopTimer();
            renderResult(true); // 시간 종료 — 자동 제출
          }
        } else {
          $("#timer").textContent = fmtClock(Math.floor((Date.now() - startedAt) / 1000));
        }
      };
      // 이어서 풀기는 중단 전 시각을 그대로 넘겨 시계를 되살린다(모의고사 마감은 실제 시각 기준)
      const startTimer = (from = Date.now(), until = from + MOCK_MINUTES * 60 * 1000) => {
        startedAt = from;
        deadline = until;
        $("#timer").classList.toggle("mock", mode === "mock");
        $("#timer").classList.remove("low");
        $("#timer").hidden = false;
        tickTimer();
        timerId = setInterval(tickTimer, 1000);
      };

      // ── Supabase 연동 — 로그인 시 북마크·오답 기록을 DB에도 남긴다 (#5 #6) ──
      // localStorage 오답노트("오답만 다시 풀기")는 그대로 두고, DB는 계정 단위 영구 기록을 담당.
      let savedIds = new Set<string>(); // 내가 저장(북마크)한 문제 id
      let recorded = false; // 세션당 오답 기록 1회 가드

      // 저장 토글 — 성공을 낙관하고 즉시 반영, 실패 시 되돌린다. 반환값: 토글 후 저장 여부(비로그인이면 null)
      const toggleSave = async (qid: string): Promise<boolean | null> => {
        if (!requireLogin()) return null;
        const uid = authSession()!.user.id;
        const wasSaved = savedIds.has(qid);
        if (wasSaved) savedIds.delete(qid);
        else savedIds.add(qid);
        updateSaveStar();
        const { error } = wasSaved
          ? await supabase.from("saved_questions").delete().eq("user_id", uid).eq("question_id", qid)
          : await supabase.from("saved_questions").upsert({ user_id: uid, question_id: qid });
        if (error) {
          if (wasSaved) savedIds.add(qid);
          else savedIds.delete(qid);
          updateSaveStar();
          alert(errorText("저장에 실패했습니다", error));
          return savedIds.has(qid);
        }
        toast(wasSaved ? "저장을 해제했습니다" : "저장했습니다 · 마이페이지에 모아둡니다");
        return savedIds.has(qid);
      };

      const paintStar = (btn: HTMLElement, on: boolean) => {
        btn.textContent = on ? "★" : "☆";
        btn.classList.toggle("on", on);
      };

      // 풀이 화면의 현재 문항 별 표시 갱신
      const updateSaveStar = () => {
        if (exam.hidden || session.length === 0) return;
        paintStar($("#save-q"), savedIds.has(session[cur].id));
      };

      // 구독은 updateSaveStar 정의 뒤에 — 인증 상태가 이미 준비됐으면 콜백이 즉시 실행된다
      onAuth(async (s) => {
        if (!s) {
          savedIds = new Set();
          updateSaveStar();
          return;
        }
        const { data, error } = await supabase.from("saved_questions").select("question_id");
        if (error) {
          console.error("저장 목록 조회 실패:", error.message);
          return;
        }
        savedIds = new Set((data ?? []).map((r: { question_id: string }) => r.question_id));
        updateSaveStar();
      });

      // 채점 시 오답을 DB에 기록 — 실패해도 채점 흐름을 막지 않는다(fire-and-forget)
      const recordWrongAnswers = () => {
        if (recorded || !authSession()) return;
        recorded = true;
        const uid = authSession()!.user.id;
        const rows = session
          .map((q, i) => ({ q, p: picked[i] }))
          .filter(({ q, p }) => p !== undefined && p !== q.answer)
          .map(({ q, p }) => ({ user_id: uid, question_id: q.id, chosen: p }));
        if (rows.length === 0) return;
        supabase
          .from("wrong_answers")
          .insert(rows)
          .then(({ error }) => {
            if (error) console.error("오답 기록 실패:", error.message);
          });
      };

      // ── 오답노트 — 규칙(간격 반복)은 lib/wrong-note.ts가 갖는다.
      // 개념 노트의 확인 문제도 같은 통·같은 규칙을 쓴다(#41 #43).
      const NOTE_KEY = noteKey(examSlug);
      const bankById = new Map(bank.map((q) => [q.id, q]));

      // 은행에서 빠진(개정·삭제된) 문제는 읽는 김에 정리한다
      const readNote = (): Note =>
        Object.fromEntries(Object.entries(loadNote(NOTE_KEY)).filter(([id]) => bankById.has(id)));

      /** 오답만 다시 풀기 — 오늘 몫부터. 오늘 몫이 없으면 노트 전체를 연다(빈손으로 돌려보내지 않는다) */
      const noteQuestions = (): Q[] => {
        const note = readNote();
        const due = dueIds(note);
        return (due.length ? due : Object.keys(note)).map((id) => bankById.get(id)!);
      };

      const refreshNoteUI = () => {
        const note = readNote();
        const count = Object.keys(note).length;
        const due = dueIds(note).length;
        // 쌓인 양이 아니라 "오늘 뭘 할지"를 먼저 말한다. 비어 있어도 카드는 남긴다 —
        // 여기가 무엇을 담는 자리인지 알려 주는 것도 화면의 일이다.
        $("#note-info").textContent =
          count === 0
            ? "아직 쌓인 오답이 없습니다. 틀린 문제가 여기 모입니다."
            : due
              ? `오늘 복습할 오답 ${due}문제 — 오답노트에 모두 ${count}문제.`
              : `오답노트에 ${count}문제 — 오늘 복습할 몫은 없습니다.`;
        const startNote = $("#start-note") as HTMLButtonElement;
        startNote.disabled = count === 0;
        startNote.textContent = due
          ? `오늘 몫 ${due}문제 풀기`
          : count
            ? "그래도 다시 풀기"
            : "오답만 다시 풀기";
        ($("#note-clear") as HTMLButtonElement).hidden = count === 0;
        $("#retry-note").hidden = count === 0;
      };

      // 조건을 접어 두었으므로 무엇으로 시작할지는 카드가 대신 말해야 한다
      const paintQuickSummary = () => {
        const scope = (document.querySelector('input[name="scope"]:checked') as HTMLInputElement).value;
        const diff = (document.querySelector('input[name="diff"]:checked') as HTMLInputElement).value;
        const count = (document.querySelector('input[name="count"]:checked') as HTMLInputElement).value;
        const [, name] = scope === "전체" ? ["", ""] : scope.split(":");
        $("#quick-summary").textContent =
          `${scope === "전체" ? "전체 범위" : name} · 난이도 ${diff} · ${count}문제 · ` +
          `${gradeIsInstant() ? "고르면 바로 확인" : "제출 후 채점"}`;
      };

      // 채점 방식은 기기에 기억한다 — 매번 기본값으로 되돌아가면 고른 줄 알고 풀다 어긋난다
      const GRADE_KEY = keyOf("daily.quiz.grade.v1");
      const gradePref = (() => {
        try {
          return localStorage.getItem(GRADE_KEY) === "instant";
        } catch {
          return false; // 시크릿 모드 등 — 기본값(제출 후)으로 연다
        }
      })();
      document.querySelectorAll<HTMLInputElement>('input[name="grade"]').forEach((el) => {
        el.checked = (el.value === "instant") === gradePref;
        el.addEventListener("change", () => {
          if (!el.checked) return;
          try {
            localStorage.setItem(GRADE_KEY, el.value);
          } catch {
            /* 저장 불가 환경은 이번 세션에만 적용된다 */
          }
        });
      });
      const gradeIsInstant = () =>
        (document.querySelector('input[name="grade"]:checked') as HTMLInputElement).value === "instant";
      setup.addEventListener("change", paintQuickSummary);

      // ── 진행 중 풀이 자동 저장 — 새로고침·탭 닫기로 답안이 날아가지 않도록 ──
      // 문항 본문은 은행에 이미 있으므로 id만 남긴다. 모의고사는 마감 시각까지 실제 시각 기준으로 이어간다.
      const SESSION_KEY = keyOf("daily.quiz.session.v1");
      type Saved = {
        ids: string[];
        picked: (number | null)[]; // 미표기는 null — JSON 배열에 undefined를 담을 수 없다
        cur: number;
        mode: "practice" | "mock";
        instant?: boolean; // 없으면 제출 후 채점 — 이 기능 이전에 저장된 풀이가 그대로 이어진다
        startedAt: number;
        deadline: number;
      };

      const persist = () => {
        try {
          const saved: Saved = {
            ids: session.map((q) => q.id),
            picked: Array.from({ length: session.length }, (_, i) => picked[i] ?? null),
            cur,
            mode,
            instant,
            startedAt,
            deadline,
          };
          localStorage.setItem(SESSION_KEY, JSON.stringify(saved));
        } catch {
          /* 시크릿 모드 등 저장 불가 환경은 조용히 무시 — 풀이는 그대로 진행된다 */
        }
      };
      const dropSaved = () => {
        try {
          localStorage.removeItem(SESSION_KEY);
        } catch {
          /* ignore */
        }
      };
      const readSaved = (): Saved | null => {
        try {
          const s = JSON.parse(localStorage.getItem(SESSION_KEY) ?? "null") as Saved | null;
          if (!s || !Array.isArray(s.ids) || s.ids.length === 0) return null;
          if (!s.ids.every((id) => bankById.has(id))) return null; // 은행이 개정됐으면 폐기
          if (s.mode === "mock" && Date.now() >= s.deadline) return null; // 이미 시간이 끝난 모의고사
          return s;
        } catch {
          return null;
        }
      };

      const refreshResumeUI = () => {
        const s = readSaved();
        $("#resume-box").hidden = !s;
        if (!s) return;
        const answered = s.picked.filter((v) => v !== null).length;
        const left =
          s.mode === "mock"
            ? ` · 남은 시간 ${fmtClock(Math.ceil((s.deadline - Date.now()) / 1000))}`
            : "";
        $("#resume-info").textContent =
          `풀던 ${s.mode === "mock" ? "모의고사" : "연습"} ${s.ids.length}문항이 남아 있습니다 — ${answered}문항 표기${left}.`;
      };

      const resumeSession = () => {
        const s = readSaved();
        if (!s) {
          refreshResumeUI();
          return;
        }
        session = s.ids.map((id) => bankById.get(id)!);
        picked = s.picked.map((v) => (v === null ? undefined : v)) as number[];
        cur = Math.min(Math.max(0, s.cur), session.length - 1);
        mode = s.mode;
        instant = s.instant ?? false;
        recorded = false;
        setup.hidden = true;
        result.hidden = true;
        exam.hidden = false;
        startTimer(s.startedAt, s.deadline);
        renderQuestion();
      };

      const startSession = (pool: Q[], reshuffle = true) => {
        if (pool.length === 0) return;
        session = reshuffle ? shuffle(pool) : pool;
        picked = [];
        cur = 0;
        recorded = false;
        setup.hidden = true;
        result.hidden = true;
        exam.hidden = false;
        // 시작 버튼은 설정 화면 아래쪽에 있다 — 그 스크롤 자리를 그대로 두면
        // 문항이 헤더 밑에서 시작한다. 그만두기·채점과 같이 맨 위에서 연다.
        window.scrollTo(0, 0);
        startTimer(); // 시작 버튼을 누른 순간부터 잰다
        renderQuestion();
      };

      // Fisher-Yates 셔플
      const shuffle = <T,>(arr: T[]): T[] => {
        const a = [...arr];
        for (let i = a.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [a[i], a[j]] = [a[j], a[i]];
        }
        return a;
      };

      /**
       * 바로 확인 모드 — 고른 순간 정오·정답·해설을 보기 아래에 편다.
       * 보기는 잠근다. 답을 본 뒤 고쳐 고를 수 있으면 "맞혔다"가 사실이 아니게 된다.
       */
      const revealAnswer = () => {
        const q = session[cur];
        const my = picked[cur];
        const hit = my === q.answer;
        $("#q-choices")
          .querySelectorAll<HTMLButtonElement>(".choice")
          .forEach((b, j) => {
            b.disabled = true;
            b.classList.toggle("correct", j === q.answer);
            b.classList.toggle("miss", j === my && !hit);
          });
        const fb = $("#q-feedback");
        fb.className = `q-feedback ${hit ? "hit" : "miss"}`;
        fb.innerHTML = `
          <p class="fb-verdict">${hit ? "정답입니다" : "틀렸습니다"}</p>
          ${hit ? "" : `<p class="rv-a">내 답: ${q.choices[my!]}<br/>정답: <b>${q.choices[q.answer]}</b></p>`}
          <p class="rv-x">${q.explanation}</p>
          ${q.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
        `;
        fb.hidden = false;
      };

      const selectChoice = (i: number) => {
        if (instant && picked[cur] !== undefined) return; // 이미 확인한 문항은 잠겨 있다
        picked[cur] = i;
        $("#q-choices")
          .querySelectorAll(".choice")
          .forEach((b, j) => {
            b.classList.toggle("on", j === i);
            b.setAttribute("aria-pressed", String(j === i));
          });
        ($("#next") as HTMLButtonElement).disabled = false;
        if (instant) revealAnswer();
        syncOMR(); // 답안지 표기 갱신
        persist();
      };

      // ── 모의고사 답안지(OMR) ──
      // 실제 시험지처럼 문항 번호와 ①~④ 마킹란을 과목별로 나눠 세로로 늘어놓는다.
      // 번호를 누르면 그 문항으로 이동하고, 마킹란을 누르면 그 자리에서 답을 표기한다.
      const OMR_MARKS = ["①", "②", "③", "④"];
      const wideOMR = window.matchMedia("(min-width: 1080px)");
      let omrRows: HTMLElement[] = [];
      let omrBuiltFor = ""; // 같은 시험지를 다시 그리지 않기 위한 식별자

      const markFromSheet = (i: number, c: number) => {
        if (i === cur) {
          selectChoice(c); // 현재 문항이면 보기 버튼 상태까지 함께 맞춘다
          return;
        }
        picked[i] = c;
        syncOMR();
        persist();
      };

      const buildOMR = () => {
        const sheet = $("#omr-sheet");
        sheet.innerHTML = "";
        omrRows = [];
        let lastSubject = "";
        session.forEach((q, i) => {
          // 과목이 바뀌는 자리에 실제 시험지처럼 과목 구분 머리글을 넣는다
          if (q.subject && q.subject !== lastSubject) {
            lastSubject = q.subject;
            const h = document.createElement("p");
            h.className = "omr-subject";
            h.textContent = q.subject;
            sheet.appendChild(h);
          }
          const row = document.createElement("div");
          row.className = "omr-row";
          const no = document.createElement("button");
          no.type = "button";
          no.className = "omr-no";
          no.textContent = String(i + 1);
          no.title = `${i + 1}번으로 이동`;
          no.setAttribute("aria-label", `${i + 1}번 문항으로 이동`);
          no.addEventListener("click", () => {
            cur = i;
            renderQuestion();
            if (!wideOMR.matches) $("#q-body").scrollIntoView({ block: "start", behavior: "smooth" });
          });
          row.appendChild(no);
          const bubbles = document.createElement("div");
          bubbles.className = "omr-bubbles";
          OMR_MARKS.forEach((m, c) => {
            const b = document.createElement("button");
            b.type = "button";
            b.className = "omr-bub";
            b.textContent = m;
            b.setAttribute("aria-label", `${i + 1}번 ${c + 1}번 보기 표기`);
            b.addEventListener("click", () => markFromSheet(i, c));
            bubbles.appendChild(b);
          });
          row.appendChild(bubbles);
          sheet.appendChild(row);
          omrRows.push(row);
        });
      };

      // 표기 상태만 칠한다 — 100문항 × 4칸을 매번 다시 만들면 스크롤이 튀므로 클래스만 갱신
      const syncOMR = () => {
        const omr = $("#omr");
        if (mode !== "mock") {
          omr.hidden = true;
          omrBuiltFor = "";
          return;
        }
        omr.hidden = false;
        const key = session.map((q) => q.id).join(",");
        if (key !== omrBuiltFor) {
          buildOMR();
          omrBuiltFor = key;
          (omr as HTMLDetailsElement).open = wideOMR.matches; // 넓은 화면에서는 펼친 채로 둔다
        }
        const answered = picked.filter((p) => p !== undefined).length;
        $("#omr-count").textContent = `${answered} / ${session.length}`;
        omrRows.forEach((row, i) => {
          row.classList.toggle("here", i === cur);
          row.classList.toggle("blank", picked[i] === undefined);
          row.querySelectorAll(".omr-bub").forEach((b, c) => {
            const on = picked[i] === c;
            b.classList.toggle("on", on);
            b.setAttribute("aria-pressed", String(on));
          });
        });
        // 현재 문항 줄이 답안지 스크롤 밖으로 나가지 않게 따라 붙인다
        const here = omrRows[cur];
        if (here && (omr as HTMLDetailsElement).open) {
          const box = $("#omr-sheet");
          const top = here.offsetTop - box.offsetTop;
          if (top < box.scrollTop || top + here.offsetHeight > box.scrollTop + box.clientHeight) {
            box.scrollTo({ top: top - box.clientHeight / 2 + here.offsetHeight, behavior: "smooth" });
          }
        }
      };

      // 화면 폭이 바뀌면 펼침 상태를 그 폭에 맞춘다(모의고사 중일 때만)
      wideOMR.addEventListener("change", (e) => {
        if (mode === "mock" && !exam.hidden) ($("#omr") as HTMLDetailsElement).open = e.matches;
      });

      const renderQuestion = () => {
        const q = session[cur];
        $("#progress").textContent = `${cur + 1} / ${session.length}`;
        const pct = ((cur + 1) / session.length) * 100;
        $("#pbar-fill").style.width = `${pct}%`;
        $("#pbar").setAttribute("aria-valuenow", String(Math.round(pct)));
        $("#pbar").setAttribute("aria-valuetext", `${session.length}문항 중 ${cur + 1}번째`);
        $("#exam-area").textContent = q.area;
        $("#exam-diff").textContent = q.difficulty;
        $("#exam-diff").dataset.level = q.difficulty;
        $("#q-text").textContent = q.question;
        const codeEl = $("#q-code");
        codeEl.hidden = !q.code;
        codeEl.textContent = q.code ?? "";
        const ol = $("#q-choices");
        ol.innerHTML = "";
        q.choices.forEach((c, i) => {
          const li = document.createElement("li");
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "choice";
          btn.setAttribute("aria-pressed", String(picked[cur] === i));
          const num = document.createElement("span");
          num.className = "choice-num";
          num.textContent = String(i + 1);
          const txt = document.createElement("span");
          txt.className = "choice-txt";
          txt.textContent = c;
          btn.append(num, txt);
          if (picked[cur] === i) btn.classList.add("on"); // 되돌아온 문항의 선택 복원
          btn.addEventListener("click", () => selectChoice(i));
          li.appendChild(btn);
          ol.appendChild(li);
        });
        const fb = $("#q-feedback");
        fb.hidden = true;
        fb.innerHTML = "";
        if (instant && picked[cur] !== undefined) revealAnswer(); // 되돌아온 문항은 편 채로
        ($("#prev") as HTMLButtonElement).disabled = cur === 0;
        const next = $("#next") as HTMLButtonElement;
        // 모의고사는 실제 시험처럼 건너뛰기 허용, 연습 모드는 답해야 진행
        next.disabled = mode === "practice" && picked[cur] === undefined;
        next.textContent = cur === session.length - 1 ? "제출하고 채점" : "다음";
        updateSaveStar();
        exam.classList.toggle("with-sheet", mode === "mock"); // 답안지가 있을 때만 2단 배치
        syncOMR();
        persist();
        // 문항 전환 페이드 — 애니메이션 재시작을 위해 리플로 강제
        const body = $("#q-body");
        body.classList.remove("swap");
        void body.offsetWidth;
        body.classList.add("swap");
        $("#q-text").focus({ preventScroll: true });
        keepQuestionInView();
      };

      /**
       * 문항 제목부터 보이게 — 스크롤을 내린 자리에서 '다음'을 누르면 고정 헤더와
       * 진행바(.exam-top)가 제목을 덮은 채로 다음 문항이 시작된다(모바일에서 특히 심하다).
       * 가려졌을 때만 끌어올린다 — 이미 보이면 화면이 튀지 않는 편이 낫다.
       */
      function keepQuestionInView() {
        const body = $("#q-body");
        if (body.getBoundingClientRect().top < $(".exam-top").getBoundingClientRect().bottom) {
          body.scrollIntoView({ block: "start" });
        }
      }

      // 점수 바 — 표시 직후 폭을 채워 트랜지션이 걸리도록 두 프레임 뒤에 적용
      const setScoreBar = (pct: number, pass: boolean) => {
        const fill = $("#score-fill");
        fill.classList.toggle("fail", !pass);
        fill.style.width = "0%";
        requestAnimationFrame(() =>
          requestAnimationFrame(() => {
            fill.style.width = `${pct}%`;
          }),
        );
      };

      const renderResult = (timedOut = false) => {
        stopTimer();
        dropSaved(); // 채점이 끝났으므로 이어서 풀 것이 없다
        const elapsedSec = Math.max(1, Math.round((Date.now() - startedAt) / 1000));
        const total = session.length;
        $("#elapsed").textContent =
          `풀이 시간 ${fmtDuration(elapsedSec)} · 문항당 평균 ${Math.round(elapsedSec / total)}초`;
        const correct = session.filter((q, i) => picked[i] === q.answer).length;
        const pct = Math.round((correct / total) * 100);

        recordWrongAnswers(); // 로그인 시 DB 오답 기록 (#6)

        // 오답노트 갱신 — 틀리면 담고 간격을 되돌리며, 맞히면 다음 복습으로 미룬다.
        // 마지막 단계를 통과하면 그때 졸업한다. 무응답은 노트를 건드리지 않는다.
        const note = readNote();
        let added = 0, spaced = 0, cleared = 0;
        session.forEach((q, i) => {
          if (picked[i] === undefined) return;
          if (picked[i] !== q.answer) {
            if (!note[q.id]) added++;
            markWrong(note, q.id);
          } else {
            const r = markRight(note, q.id);
            if (r === "spaced") spaced++;
            else if (r === "cleared") cleared++;
          }
        });
        saveNote(NOTE_KEY, note);
        const remain = Object.keys(note).length;
        const parts: string[] = [];
        if (added) parts.push(`오답 ${added}문제를 오답노트에 담았습니다`);
        if (spaced) parts.push(`${spaced}문제는 다음 복습으로 미뤘습니다`);
        if (cleared) parts.push(`${cleared}문제를 오답노트에서 졸업시켰습니다`);
        $("#note-status").textContent =
          remain === 0
            ? cleared
              ? "오답노트를 모두 비웠습니다. 깔끔합니다."
              : ""
            : `${parts.join(" · ")}${parts.length ? " — " : ""}오답노트에 ${remain}문제 남아 있습니다.`;
        refreshNoteUI();

        const subjects = $("#subjects");
        if (mode === "mock") {
          // 과목별 채점 — 과목별 과락선 미만이면 과락, 과락 없이 평균 합격선 이상이면 합격
          const perSubject = SUBJECT_LIST.map((sj, i) => {
            const qs = session.map((q, qi) => ({ q, qi })).filter(({ q }) => q.subject === sj);
            const ok = qs.filter(({ q, qi }) => picked[qi] === q.answer).length;
            const score = qs.length ? Math.round((ok / qs.length) * 100) : 0;
            return { no: i + 1, subject: sj, ok, total: qs.length, score, fail: score < written.subjectPass };
          });
          const avg = Math.round(perSubject.reduce((s, p) => s + p.score, 0) / perSubject.length);
          const failed = perSubject.filter((p) => p.fail);
          const pass = avg >= written.averagePass && failed.length === 0;
          $("#score").textContent = `평균 ${avg}점 — ${pass ? "합격" : "불합격"}`;
          setScoreBar(avg, pass);
          $("#verdict").textContent = [
            timedOut ? "시간이 종료되어 자동 제출되었습니다." : "",
            failed.length
              ? `과락(${written.subjectPass}점 미만): ${failed.map((p) => `${p.no}과목 ${p.subject}`).join(", ")}.`
              : avg >= written.averagePass
                ? `과락 없이 평균 ${written.averagePass}점을 넘겼습니다.`
                : `과락은 없지만 평균이 ${written.averagePass}점에 못 미칩니다.`,
            "아래에서 틀린 문항만 복기하세요.",
          ].filter(Boolean).join(" ");
          subjects.innerHTML = perSubject
            .map(
              (p) => `
              <div class="subj${p.fail ? " fail" : ""}" style="--w:${p.score}%">
                <span class="subj-area">${p.no}과목 ${p.subject}</span>
                <span class="subj-count mono">${p.ok} / ${p.total}</span>
                <span class="subj-score">${p.score}점${p.fail ? " · 과락" : ""}</span>
              </div>`,
            )
            .join("");
          subjects.hidden = false;
          $("#weak-cta").hidden = true; // 모의고사는 과락 문구가 판정을 대신한다
        } else {
          $("#score").textContent = `${correct} / ${total} (${pct}점)`;
          setScoreBar(pct, pct >= 60);
          $("#verdict").textContent =
            pct >= 60 ? "합격권입니다. 틀린 문제만 다져두세요." : "아직 위험합니다. 오답 해설과 개념 글을 먼저 읽어보세요.";

          // 영역별 분해 — 연습은 과목이 아니라 영역으로 가른다. 개념 노트가 영역으로 갈려 있어
          // "약한 영역 → 그 영역 개념 노트"가 한 줄로 이어지기 때문이다(모의고사는 합격 판정이
          // 목적이라 과목·과락 축을 그대로 둔다).
          // 연습은 5·10·15문항이라 영역당 표본이 1~2문제다. 백분율로 적으면 0점·100점으로 튀어
          // 진단이 아니라 소음이 되므로, "맞은 수 / 나온 수"를 1급 정보로 두고 막대만 비율로 채운다.
          const perArea = AREA_LIST.map((a) => {
            const mine = session.map((q, i) => ({ q, i })).filter(({ q }) => q.area === a);
            const ok = mine.filter(({ q, i }) => picked[i] === q.answer).length;
            return { area: a, ok, total: mine.length, wrong: mine.length - ok };
          }).filter((r) => r.total > 0);
          const weak = perArea.filter((r) => r.wrong > 0).sort((a, b) => b.wrong - a.wrong);

          // 영역을 골라 푼 세션은 쪼갤 것이 없다 — 한 줄짜리 분해는 점수를 되풀이할 뿐이다
          if (perArea.length > 1) {
            subjects.innerHTML = [...perArea]
              .sort((a, b) => b.wrong - a.wrong)
              .map(
                (r) => `
              <div class="subj${r.wrong ? " weak" : ""}" style="--w:${Math.round((r.ok / r.total) * 100)}%">
                <span class="subj-area">${r.area}</span>
                <span class="subj-count mono">${r.ok} / ${r.total}문항</span>
                <span class="subj-score">${r.wrong ? `${r.wrong}개 틀림` : "전부 맞힘"}</span>
              </div>`,
              )
              .join("");
            subjects.hidden = false;
          } else {
            subjects.hidden = true;
          }

          // 약점 CTA — 가장 많이 틀린 영역 둘에 "더 풀기 / 개념 노트"를 붙여 다음 행동을 준다
          const cta = $("#weak-cta");
          cta.innerHTML = weak
            .slice(0, 2)
            .map(
              (r) => `
              <div class="weak-row">
                <span class="weak-name">${r.area}</span>
                <button type="button" class="ghost" data-area="${r.area}">${total}문제 더 풀기</button>
                <a class="weak-note" href="${notesBase}${areaSlugs[r.area] ?? ""}/">개념 노트 →</a>
              </div>`,
            )
            .join("");
          cta.hidden = weak.length === 0;
        }

        const review = $("#review");
        review.innerHTML = "";
        session.forEach((q, i) => {
          const unanswered = picked[i] === undefined;
          const wrong = picked[i] !== q.answer;
          if (mode === "mock" && !wrong) return; // 모의고사 복기는 틀린 문항만
          const card = document.createElement("article");
          card.className = wrong ? "rv wrong" : "rv";
          card.innerHTML = `
            <p class="rv-q"><span class="badge">${q.area}</span> <span class="badge diff" data-level="${q.difficulty}">${q.difficulty}</span> ${q.question}</p>
            ${q.code ? `<pre class="q-code mono">${esc(q.code)}</pre>` : ""}
            <p class="rv-a">${wrong ? `내 답: ${unanswered ? "무응답" : q.choices[picked[i]]}<br/>` : ""}정답: <b>${q.choices[q.answer]}</b></p>
            <p class="rv-x">${q.explanation}</p>
            ${q.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
          `;
          // 복기 카드에서도 문제 저장 토글 (#5)
          const star = document.createElement("button");
          star.type = "button";
          star.className = "save-star rv-save";
          star.title = "이 문제 저장";
          star.setAttribute("aria-label", "이 문제 저장");
          paintStar(star, savedIds.has(q.id));
          star.addEventListener("click", async () => {
            const on = await toggleSave(q.id);
            if (on !== null) paintStar(star, on);
          });
          card.appendChild(star);
          review.appendChild(card);
        });
        // 연습 모드는 정답까지 모두 나열되므로 오답만 추리는 필터를 붙인다(모의고사는 이미 오답만)
        const wrongCount = session.filter((q, i) => picked[i] !== q.answer).length;
        const onlyWrong = $("#only-wrong") as HTMLButtonElement;
        // 해설은 "왜 틀렸나"의 근거지 결과 화면의 본문이 아니다 — 틀린 게 있으면 오답만 펼친
        // 상태로 열고, 전체는 토글로 되돌린다.
        const collapse = wrongCount > 0;
        review.classList.toggle("only-wrong", collapse);
        onlyWrong.setAttribute("aria-pressed", String(collapse));
        onlyWrong.classList.toggle("on", collapse);
        onlyWrong.textContent = `틀린 문제만 보기 (${wrongCount})`;
        $("#review-tools").hidden = mode === "mock" || wrongCount === 0 || wrongCount === total;

        exam.hidden = true;
        result.hidden = false;
        window.scrollTo(0, 0);
        $("#score").focus({ preventScroll: true });
      };

      $("#start").addEventListener("click", () => {
        // scope는 "전체" | "과목:<과목명>" | "영역:<영역명>" — 과목과 영역 중 하나만 고른다
        const scope = (document.querySelector('input[name="scope"]:checked') as HTMLInputElement).value;
        const diff = (document.querySelector('input[name="diff"]:checked') as HTMLInputElement).value;
        const count = Number((document.querySelector('input[name="count"]:checked') as HTMLInputElement).value);
        const [kind, name] = scope === "전체" ? ["전체", ""] : scope.split(":");
        const pool = bank
          .filter((q) => kind === "전체" || (kind === "과목" ? q.subject === name : q.area === name))
          .filter((q) => diff === "전체" || q.difficulty === diff);
        if (pool.length === 0) {
          alert("선택한 과목·영역과 난이도 조합에 해당하는 문항이 아직 없습니다.");
          return;
        }
        mode = "practice";
        instant = gradeIsInstant();
        startSession(shuffle(pool).slice(0, count));
      });

      // 모의고사 — 실제 시험대로 과목 순서·과목당 20문항 출제, 150분 타이머
      $("#start-mock").addEventListener("click", () => {
        const paper = SUBJECT_LIST.flatMap((s) =>
          shuffle(bank.filter((q) => q.subject === s)).slice(0, MOCK_PER_SUBJECT),
        );
        mode = "mock";
        instant = false; // 실제 시험 재현 — 푸는 도중에는 정답을 보지 않는다
        startSession(paper, false);
      });

      // 오답만 다시 풀기 — 설정 화면·결과 화면 양쪽에서 진입
      const startNoteSession = () => {
        mode = "practice";
        instant = gradeIsInstant();
        startSession(noteQuestions());
      };
      $("#start-note").addEventListener("click", startNoteSession);
      $("#retry-note").addEventListener("click", startNoteSession);

      // 약점 CTA의 "더 풀기" — 그 영역만 다시 뽑아 방금과 같은 문항 수로 이어 푼다
      $("#weak-cta").addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest("button[data-area]") as HTMLButtonElement | null;
        if (!btn) return;
        const pool = bank.filter((q) => q.area === btn.dataset.area);
        if (pool.length === 0) return;
        const n = session.length;
        mode = "practice";
        instant = gradeIsInstant();
        startSession(shuffle(pool).slice(0, n));
      });

      $("#save-q").addEventListener("click", () => toggleSave(session[cur].id));

      $("#prev").addEventListener("click", () => {
        if (cur > 0) {
          cur--;
          renderQuestion();
        }
      });

      // 풀이 중단 — 기록 없이 설정 화면으로 복귀
      $("#quit").addEventListener("click", () => {
        if (!confirm("진행 중인 풀이를 그만둘까요? 지금까지의 답은 저장되지 않습니다.")) return;
        stopTimer();
        dropSaved();
        exam.hidden = true;
        setup.hidden = false;
        refreshNoteUI();
        refreshResumeUI();
        window.scrollTo(0, 0);
      });

      $("#note-clear").addEventListener("click", () => {
        saveNote(NOTE_KEY, {});
        refreshNoteUI();
      });

      $("#next").addEventListener("click", () => {
        if (cur < session.length - 1) {
          cur++;
          renderQuestion();
        } else {
          // 모의고사는 건너뛴 문항이 있으면 제출 전에 한 번 확인
          if (mode === "mock") {
            const un = session.filter((_, i) => picked[i] === undefined).length;
            if (un > 0 && !confirm(`무응답 ${un}문항이 있습니다. 지금 제출하고 채점할까요?`)) return;
          }
          renderResult();
        }
      });

      // 키보드 단축키 — 1~4 선택, ←/→ 이동, Enter 다음(버튼 포커스 중엔 기본 동작에 맡김)
      document.addEventListener("keydown", (e) => {
        if (exam.hidden || e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key >= "1" && e.key <= "4") {
          selectChoice(Number(e.key) - 1);
          e.preventDefault();
        } else if (e.key === "ArrowLeft") {
          if (cur > 0) {
            cur--;
            renderQuestion();
          }
        } else if (e.key === "ArrowRight" || e.key === "Enter") {
          if (e.key === "Enter" && (document.activeElement as HTMLElement | null)?.closest("button, summary, a")) return;
          const next = $("#next") as HTMLButtonElement;
          if (!next.disabled) next.click();
        }
      });

      $("#retry").addEventListener("click", () => {
        result.hidden = true;
        setup.hidden = false;
        window.scrollTo(0, 0);
      });

      $("#only-wrong").addEventListener("click", () => {
        const on = $("#review").classList.toggle("only-wrong");
        const btn = $("#only-wrong");
        btn.setAttribute("aria-pressed", String(on));
        btn.classList.toggle("on", on);
      });

      // 이어서 풀기 / 버리기
      $("#resume-go").addEventListener("click", resumeSession);
      $("#resume-drop").addEventListener("click", () => {
        if (!confirm("중단된 풀이를 버릴까요? 표기한 답은 지워집니다.")) return;
        dropSaved();
        refreshResumeUI();
      });

      refreshNoteUI();
      refreshResumeUI();
      paintQuickSummary();
    </script>
  </body>
</html>
