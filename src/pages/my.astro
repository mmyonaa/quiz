---
import { EXAMS, EXAM_FORMAT, EXAM_SLUGS, TOPICS } from "../content.config";
import { introLead, loadBank, loadPractical, topicNoteHref } from "../lib/bank";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

// 마이페이지 — DB에 쌓인 내 오답 기록·저장 문제를 보는 화면 (#7).
// 문제 본문·해설은 빌드 타임에 굽고, DB에서는 id·횟수·날짜만 온다.
const bank = await loadBank();
// 실기 문항도 같은 통(saved_questions·saved_notes)에 담기므로 여기서 같이 굽는다 —
// id만 들고 오는 DB 기록을 본문으로 되살리려면 두 은행이 다 있어야 한다.
const practical = await loadPractical();

// 저장한 개념 카드가 쓸 주제 사전 — 제목 · 개념 노트 주소 · 도입부 한 입.
// DB는 문항 id만 주므로, "어느 주제의 개념인가"를 되살리려면 이 셋이 빌드물에 실려야 한다.
// 도입부 전체가 아니라 발췌인 이유는 카드가 목록의 한 장이기 때문이다 — 전문은 링크 끝에 있다.
const NOTE_TOPICS = Object.fromEntries(
  Object.entries(TOPICS).map(([key, t]) => [
    key,
    { title: t.title, href: topicNoteHref(key), lead: introLead(t.intro) },
  ]),
);

const BLOG_POST_BASE = "https://mmyonaa.github.io/blog/blog/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// 비로그인 관문이 "이 기기에 이미 쌓인 것"을 말하려면 시험별 저장 키를 알아야 한다
// label 은 머리의 시험 전환과 같은 이름이어야 한다 — 한 화면에서 같은 시험을 달리 부르면 둘로 보인다
const EXAM_LIST = EXAMS.map((e) => ({ exam: e, label: EXAM_FORMAT[e].label, slug: EXAM_SLUGS[e] ?? "", path: EXAM_SLUGS[e] ? `/${EXAM_SLUGS[e]}` : "" }));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — 마이페이지</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="description" content="내 오답노트와 저장한 문제 — 계정에 영구 보관됩니다." />
    {/* 고른 시험의 액센트를 첫 페인트 전에 건다 — 스크립트가 돌 때 걸면 코랄로 한 번 그렸다가
        블루로 바뀌어 번쩍인다. 머리의 테마 선점과 같은 수법이다.
        시험 축이 있는 페이지는 라우트가 <html>에 심지만, 보관함은 공용이라 고른 값이 정한다. */}
    <script is:inline define:vars={{ slugs: Object.fromEntries(EXAM_LIST.map((e) => [e.exam, e.slug])) }}>
      try {
        var picked = localStorage.getItem("daily.quiz.my-exam");
        var slug = picked ? slugs[picked] : "";
        if (slug) document.documentElement.dataset.exam = slug;
      } catch (e) {}
    </script>
  </head>
  <body>
    <SiteHeader current="my" shared />

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 보관함 메뉴(개념 노트의 사이드 목차와 같은 자리). 좁으면 상단 탭 */}
      <aside id="side-menu" class="side-toc" aria-label="보관함 메뉴" hidden>
        <span class="side-toc-title">보관함</span>
        <button id="side-wrong" class="side-link on" type="button">오답노트 <em data-count="wrong"></em></button>
        <button id="side-saved" class="side-link" type="button">저장한 문제 <em data-count="saved"></em></button>
        <button id="side-notes" class="side-link" type="button">저장한 개념 <em data-count="notes"></em></button>
      </aside>

      <div class="side-body">
      {/* 비로그인 관문 */}
      <section id="gate" class="panel flat" hidden>
        <h1>마이페이지</h1>
        <p class="lead">오답 기록과 저장한 문제는 계정에 보관됩니다. 로그인하면 어느 기기에서든 이어서 볼 수 있어요.</p>

        {/* 이 기기에 이미 쌓인 것 — 로그인의 이유를 추상적으로 말하는 대신 눈앞의 기록으로 말한다.
            비어 있으면 통째로 숨고, 관문은 원래의 문장 하나 + 버튼 하나로 돌아간다. */}
        <div id="local-note" class="local-note" hidden>
          <h2 class="group-title">이 기기에 쌓인 오답노트</h2>
          <div class="subjects">
            {EXAM_LIST.map(({ exam, slug, path }) => (
              <div class="subj local-row" data-slug={slug} hidden>
                <span class="subj-area">{exam}</span>
                <span class="subj-count" data-role="due"></span>
                <span class="subj-score" data-role="total"></span>
                <a class="weak-note" href={`${base}${path}/`}>풀러 가기 →</a>
              </div>
            ))}
          </div>
          <p class="my-hint">
            기기에만 있는 기록이라 브라우저를 지우면 함께 사라집니다. 로그인하면 계정에 남습니다.
          </p>
        </div>

        <button id="gate-login" class="primary" type="button">Google로 로그인</button>
      </section>

      <section id="my" class="panel flat" hidden>
        <h1>마이페이지</h1>
        {/* 시험 전환 — 보관함은 두 시험이 한 통에 쌓이는 유일한 화면이다. 머리의 전환과 같은
            모양을 쓰되 '전체'가 하나 더 있다; 여기는 두 시험을 함께 보는 것도 뜻이 있는 자리다.
            칩마다 그 시험에 몇 개가 쌓였는지를 달아, 고르기 전에 어느 쪽이 밀렸는지 보이게 한다. */}
        <span id="exam-filter" class="exam-switch my-exam" role="group" aria-label="시험 선택">
          <button class="exam-tab on" type="button" data-exam="" data-slug="">전체 <em data-ecount=""></em></button>
          {EXAM_LIST.map(({ exam, label, slug }) => (
            <button class="exam-tab" type="button" data-exam={exam} data-slug={slug}>{label} <em data-ecount={exam}></em></button>
          ))}
        </span>
        <div class="tabs" role="tablist">
          <button id="tab-wrong" class="tab on" type="button" role="tab">오답노트 <em data-count="wrong"></em></button>
          <button id="tab-saved" class="tab" type="button" role="tab">저장한 문제 <em data-count="saved"></em></button>
          <button id="tab-notes" class="tab" type="button" role="tab">저장한 개념 <em data-count="notes"></em></button>
        </div>

        <div id="pane-wrong">
          <div class="my-toolbar">
            <span class="my-hint">채점 때 틀린 문제가 자동으로 쌓입니다.</span>
            <select id="wrong-sort" class="sort" aria-label="정렬">
              <option value="recent">최신 순</option>
              <option value="count">많이 틀린 순</option>
            </select>
          </div>
          <div id="wrong-list"></div>
          <p id="wrong-empty" class="empty" hidden>아직 오답 기록이 없습니다. 문제를 풀면 틀린 문제가 여기에 쌓여요.</p>
        </div>

        <div id="pane-saved" hidden>
          <div class="my-toolbar">
            <span class="my-hint">필기·실기 풀이 화면에서 북마크를 눌러 저장한 문제입니다.</span>
          </div>
          <div id="saved-list"></div>
          <p id="saved-empty" class="empty" hidden>저장한 문제가 없습니다. 풀이 중 북마크 버튼으로 담아두세요.</p>
        </div>

        <div id="pane-notes" hidden>
          <div class="my-toolbar">
            <span class="my-hint">개념 노트에서 북마크를 눌러 저장한 개념·실기 확인 문제입니다.</span>
          </div>
          <div id="notes-list"></div>
          <p id="notes-empty" class="empty" hidden>저장한 개념이 없습니다. 개념 노트에서 북마크 버튼으로 담아두세요.</p>
        </div>
      </section>
      </div>
    </main>

    <script is:inline type="application/json" id="bank" set:html={JSON.stringify(bank)} />
    <script is:inline type="application/json" id="practical" set:html={JSON.stringify(practical)} />
    <script is:inline type="application/json" id="config" set:html={JSON.stringify({ blogPostBase: BLOG_POST_BASE, examLabels: Object.fromEntries(EXAM_LIST.map((e) => [e.exam, e.label])), noteTopics: NOTE_TOPICS })} />

    <script>
      import { supabase } from "../lib/supabase";
      import { codeHtml, mountCodeCopy } from "../lib/code-block";
      import { md } from "../lib/md";
      import { onAuth, authSession, loginWithGoogle, errorText } from "../lib/auth";
      import { isSelfGraded } from "../lib/practical-grade";
      import { dueIds, loadNote, noteKey } from "../lib/wrong-note";

      type Q = {
        id: string;
        exam: string; // 보관함은 두 시험이 섞여 쌓이므로 항목마다 어느 시험인지 들고 있어야 한다
        topic: string; // 주제 키 — 저장한 개념 카드가 이걸로 주제 제목·도입부·노트 주소를 찾는다
        concept?: string; // 문제 위에 붙는 '외울 한 줄' — 순수 정의형 문항에는 없다
        area: string;
        difficulty: string;
        question: string;
        code?: string;
        lang?: string; // 제시문의 언어 — 라벨과 복사 버튼의 자격
        choices: string[];
        answer: number;
        explanation: string;
        relatedPost?: string; // 선택 — 글이 아직 없는 문항은 링크 없이 렌더
      };
      /** 실기 문항 — 보기가 없고 답란이 여럿이라 필기와 카드 모양이 다르다 */
      type PQ = {
        id: string;
        exam: string;
        topic: string;
        area: string;
        difficulty: string;
        kind: string;
        question: string;
        code?: string;
        lang?: string;
        answers: string[][]; // 답란마다 [정답, 인정 표기…]
        labels?: string[];
        modelAnswer?: string;
        keywords?: string[];
        explanation: string;
        topicTitle: string;
        relatedPost?: string;
      };
      type Item = Q | PQ;
      const isPractical = (q: Item): q is PQ => "kind" in q;

      type WrongRow = { question_id: string; chosen: number; answered_at: string };
      type WrongItem = { q: Q; count: number; lastChosen: number; lastAt: string };

      const bank: Q[] = JSON.parse(document.getElementById("bank")!.textContent!);
      const practical: PQ[] = JSON.parse(document.getElementById("practical")!.textContent!);
      const { blogPostBase, examLabels: EXAM_LABEL, noteTopics: NOTE_TOPICS } = JSON.parse(document.getElementById("config")!.textContent!) as {
        blogPostBase: string;
        examLabels: Record<string, string>;
        noteTopics: Record<string, { title: string; href?: string; lead: string }>;
      };
      // 저장·오답 기록은 id만 들고 온다 — 두 은행을 한 자로 찾는다(id는 겹치지 않는다)
      const itemById = new Map<string, Item>([...bank, ...practical].map((q) => [q.id, q]));
      const bankById = new Map(bank.map((q) => [q.id, q]));

      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;
      // 상단 탭·사이드 메뉴 양쪽의 건수 표시를 한 번에 갱신
      const setCount = (key: string, n: number) =>
        document.querySelectorAll(`[data-count="${key}"]`).forEach((el) => (el.textContent = String(n)));

      let wrongs: WrongItem[] = [];
      let saved: Item[] = [];
      let notes: Item[] = [];

      // ── 시험 거르개 ──
      // 세 탭이 모두 같은 거르개를 받는다. 고른 것은 기기에 남는다 — 한 시험만 보는 사람이
      // 올 때마다 '전체'로 되돌아가면 매번 같은 손질을 되풀이하게 된다.
      const EXAM_KEY = "daily.quiz.my-exam";
      let examFilter = "";
      try {
        examFilter = localStorage.getItem(EXAM_KEY) ?? "";
      } catch {
        /* 시크릿 모드 — 전체로 둔다 */
      }
      const inExam = (q: Item) => !examFilter || q.exam === examFilter;

      const fmtDate = (iso: string) =>
        new Date(iso).toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });

      const card = (q: Q, metaHTML: string) => {
        const el = document.createElement("article");
        el.className = "rv wrong";
        el.innerHTML = `
          <p class="rv-q"><span class="badge">${q.area}</span> <span class="badge diff" data-level="${q.difficulty}">${q.difficulty}</span> ${md(q.question)}</p>
          ${q.code ? codeHtml(q.code, q.lang) : ""}
          ${metaHTML}
          <p class="rv-a">정답: <b>${q.choices[q.answer]}</b></p>
          <p class="rv-x">${md(q.explanation)}</p>
          ${q.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
        `;
        return el;
      };

      /** 실기 카드 — 보기가 없으니 정답을 바로 펴 둔다(개념 노트의 '정답 보기'를 연 모양).
          답란이 여럿이라 라벨과 정답을 줄로 세우고, 약술형은 모범답안 한 덩이다. */
      const paCard = (p: PQ) => {
        const el = document.createElement("article");
        el.className = "rv";
        const label = (i: number) => p.labels?.[i] ?? (p.answers.length > 1 ? `${i + 1}번 답란` : "정답");
        const answer =
          isSelfGraded(p.kind)
            ? `<p class="cn-pa-line stacked"><span class="cn-pa-key">모범답안</span><span>${md(p.modelAnswer ?? "")}</span></p>` +
              (p.keywords?.length ? `<p class="cn-pa-alt">핵심어 — ${p.keywords.join(" · ")}</p>` : "")
            : p.answers.map((acc, i) => `<p class="cn-pa-line"><span class="cn-pa-key">${label(i)}</span><strong class="mono">${acc[0]}</strong></p>`).join("") +
              (p.answers.some((a) => a.length > 1)
                ? `<p class="cn-pa-alt">함께 정답 처리되는 표기 — ${p.answers.map((a) => a.slice(1).join(", ")).filter(Boolean).join(" / ")}</p>`
                : "");
        el.innerHTML = `
          <p class="rv-q"><span class="pa-tag">실기</span> <span class="badge">${p.kind}</span> <span class="badge diff" data-level="${p.difficulty}">${p.difficulty}</span> ${md(p.question)}</p>
          ${p.code ? codeHtml(p.code, p.lang) : ""}
          <div class="cn-pa-ans">${answer}<p class="cn-x cn-pa-exp">${md(p.explanation)}</p></div>
          ${p.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${p.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
        `;
        return el;
      };

      const renderWrongs = () => {
        const sort = ($("#wrong-sort") as HTMLSelectElement).value;
        const items = wrongs.filter((w) => inExam(w.q)).sort((a, b) =>
          sort === "count" ? b.count - a.count || b.lastAt.localeCompare(a.lastAt) : b.lastAt.localeCompare(a.lastAt),
        );
        setCount("wrong", items.length);
        paintEmpty("#wrong-empty", items.length, wrongs.length,
          "아직 오답 기록이 없습니다. 문제를 풀면 틀린 문제가 여기에 쌓여요.");
        const list = $("#wrong-list");
        list.innerHTML = "";
        items.forEach((it) => {
          const meta = `
            <p class="rv-meta mono">${it.count}회 틀림 · 마지막 ${fmtDate(it.lastAt)}</p>
            <p class="rv-a">내 답: ${it.q.choices[it.lastChosen] ?? "?"}</p>`;
          const el = card(it.q, meta);
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "기록 삭제";
          del.addEventListener("click", async () => {
            if (!confirm("이 문제의 오답 기록을 모두 삭제할까요?")) return;
            const { error } = await supabase
              .from("wrong_answers")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", it.q.id);
            if (error) {
              alert(errorText("삭제에 실패했습니다", error));
              return;
            }
            wrongs = wrongs.filter((w) => w.q.id !== it.q.id);
            renderAll();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      const renderSaved = () => {
        const items = saved.filter(inExam);
        setCount("saved", items.length);
        paintEmpty("#saved-empty", items.length, saved.length,
          "저장한 문제가 없습니다. 풀이 중 북마크 버튼으로 담아두세요.");
        const list = $("#saved-list");
        list.innerHTML = "";
        items.forEach((q) => {
          const el = isPractical(q) ? paCard(q) : card(q, "");
          el.className = "rv"; // 저장 목록은 오답 색을 쓰지 않는다
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "저장 해제";
          del.addEventListener("click", async () => {
            const { error } = await supabase
              .from("saved_questions")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", q.id);
            if (error) {
              alert(errorText("해제에 실패했습니다", error));
              return;
            }
            saved = saved.filter((s) => s.id !== q.id);
            renderAll();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      // 저장한 개념 — 개념 노트처럼 해설을 앞세워 렌더
      const renderNotes = () => {
        const items = notes.filter(inExam);
        setCount("notes", items.length);
        paintEmpty("#notes-empty", items.length, notes.length,
          "저장한 개념이 없습니다. 개념 노트에서 북마크 버튼으로 담아두세요.");
        const list = $("#notes-list");
        list.innerHTML = "";
        items.forEach((q) => {
          // 어느 주제의 개념인가 — 카드의 머리. 영역 배지(예: 보안)까지만 있던 자리라
          // 정작 "무엇을 저장했나"를 화면에서 알 수 없었다. 제목은 그 주제의 개념 노트로 가는
          // 링크를 겸한다 — 블로그 글은 주제 138개 중 56개에만 있어서, 개념 글 링크만 두면
          // 나머지에서는 저장해 둔 카드에서 나갈 길이 하나도 없다.
          const t = NOTE_TOPICS[q.topic];
          const head = `
            <p class="note-head">
              <span class="badge">${q.area}</span>
              ${t?.href ? `<a class="note-topic" href="${t.href}">${t.title} →</a>` : `<span class="note-topic">${t?.title ?? ""}</span>`}
            </p>`;
          // 실기는 해설만으로 서지 않는다 — 보기가 없어 "무엇을 묻는 문제였나"가 발문에만 있다
          const el = isPractical(q) ? paCard(q) : document.createElement("article");
          if (isPractical(q)) {
            // 실기 카드는 발문·모범답안·해설로 이미 길다 — 머리만 얹고 도입부는 들이지 않는다
            el.insertAdjacentHTML("afterbegin", head);
          } else {
            el.className = "rv note";
            // 개념 메모지를 해설 위에 세운다 — 개념 노트에서 저장 버튼이 붙어 있던 바로 그 줄이다.
            // 누를 때 옆에 있던 것이 돌아오면 사라져 있으면 무엇을 담았는지 알 수 없다.
            // 도입부 발췌가 그 아래 선다 — 탭 이름이 가리키는 '개념'이 실은 이 글이고,
            // 지금껏 들어오던 것은 그 문항의 해설뿐이었다. 전문은 제목 링크 끝에 있다.
            // 발문·선지는 일부러 넣지 않는다 — 그걸 넣으면 '저장한 문제' 탭과 같아져
            // 탭을 나눈 뜻이 없어진다. 여기는 "이 개념을 다시 읽을래"로 담는 자리다.
            // 순수 정의형(concept 없음)은 메모지 줄만 빠지고 나머지는 그대로 선다.
            el.innerHTML = `
              ${head}
              ${q.concept ? `<p class="cn-concept">${md(q.concept)}</p>` : ""}
              ${t?.lead ? `<p class="note-lead">${md(t.lead)}</p>` : ""}
              <p class="rv-x">${md(q.explanation)}</p>
              ${q.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
            `;
          }
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "저장 해제";
          del.addEventListener("click", async () => {
            const { error } = await supabase
              .from("saved_notes")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", q.id);
            if (error) {
              alert(errorText("해제에 실패했습니다", error));
              return;
            }
            notes = notes.filter((x) => x.id !== q.id);
            renderAll();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      const load = async () => {
        const [w, s, n] = await Promise.all([
          supabase.from("wrong_answers").select("question_id, chosen, answered_at").order("answered_at", { ascending: false }),
          supabase.from("saved_questions").select("question_id, created_at").order("created_at", { ascending: false }),
          supabase.from("saved_notes").select("question_id, created_at").order("created_at", { ascending: false }),
        ]);
        if (w.error || s.error) {
          alert(errorText("기록을 불러오지 못했습니다", (w.error ?? s.error)!));
          return;
        }
        // saved_notes는 스키마 추가분 — 미적용 DB에서도 나머지 탭은 동작해야 한다
        if (n.error) console.error("저장한 개념 조회 실패:", n.error.message);
        notes = n.error
          ? []
          : (n.data as { question_id: string }[]).map((r) => itemById.get(r.question_id)).filter((q): q is Item => !!q);
        // question_id로 묶기 — 내림차순이라 첫 등장이 최신 기록
        const byId = new Map<string, WrongItem>();
        (w.data as WrongRow[]).forEach((r) => {
          const q = bankById.get(r.question_id);
          if (!q) return; // 은행에서 빠진 문제는 표시하지 않는다
          const it = byId.get(r.question_id);
          if (it) it.count++;
          else byId.set(r.question_id, { q, count: 1, lastChosen: r.chosen, lastAt: r.answered_at });
        });
        wrongs = [...byId.values()];
        saved = (s.data as { question_id: string }[]).map((r) => itemById.get(r.question_id)).filter((q): q is Item => !!q);
        renderAll();
      };

      /**
       * 빈 자리 문구 — 거르개를 켜 둔 채 비었을 때 "아직 기록이 없습니다"는 거짓말이다.
       * 다른 시험에는 쌓여 있는데 그 말을 보면 기록이 사라진 줄 안다.
       */
      const paintEmpty = (sel: string, shown: number, total: number, base: string) => {
        const el = $(sel);
        el.hidden = shown > 0;
        el.textContent = shown === 0 && examFilter && total > 0
          ? `${EXAM_LABEL[examFilter] ?? examFilter}에는 없습니다 — 다른 시험에 ${total}개가 있습니다.`
          : base;
      };

      /** 거르개 칩의 건수 — 세 통을 합쳐 시험별로 센다. 거르개와 무관하게 '전부'를 센다 */
      const paintExamCounts = () => {
        const all: Item[] = [...wrongs.map((w) => w.q), ...saved, ...notes];
        document.querySelectorAll<HTMLElement>("[data-ecount]").forEach((el) => {
          const want = el.dataset.ecount ?? "";
          const n = want ? all.filter((q) => q.exam === want).length : all.length;
          el.textContent = String(n);
        });
      };

      const renderAll = () => {
        renderWrongs();
        renderSaved();
        renderNotes();
        paintExamCounts();
      };

      $("#exam-filter").addEventListener("click", (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".exam-tab");
        if (!btn) return;
        examFilter = btn.dataset.exam ?? "";
        try {
          localStorage.setItem(EXAM_KEY, examFilter);
        } catch {
          /* 저장 못 해도 이 화면에서는 걸린다 */
        }
        paintExamPick();
        renderAll();
      });

      /**
       * 고른 시험을 칩과 **페이지 액센트**에 함께 반영한다.
       *
       * 액센트를 `<html>`의 `data-exam`으로 거는 것은 다른 화면과 같은 방법이다 — 시험 축이 있는
       * 페이지는 라우트가 심고, 공용인 보관함은 고른 값이 심는다. 정처기는 코랄이 기본값이라
       * 지우는 것으로 돌아간다(`전체`도 같다 — 두 시험을 함께 보는 자리에 한쪽 색을 칠할 수 없다).
       */
      const paintExamPick = () => {
        document.querySelectorAll<HTMLElement>("#exam-filter .exam-tab").forEach((b) => {
          const on = b.dataset.exam === examFilter;
          b.classList.toggle("on", on);
          b.setAttribute("aria-pressed", String(on));
          if (on) {
            const slug = b.dataset.slug ?? "";
            if (slug) document.documentElement.dataset.exam = slug;
            else delete document.documentElement.dataset.exam;
          }
        });
      };

      // 기기에 남은 선택을 첫 그리기 전에 반영한다
      paintExamPick();

      // 탭 전환 — 상단 탭과 좌측 사이드 메뉴가 같은 상태를 공유한다
      const TABS = ["wrong", "saved", "notes"] as const;
      const showTab = (tab: (typeof TABS)[number]) => {
        TABS.forEach((t) => {
          $(`#tab-${t}`).classList.toggle("on", t === tab);
          $(`#side-${t}`).classList.toggle("on", t === tab);
          $(`#pane-${t}`).hidden = t !== tab;
        });
      };
      TABS.forEach((t) => {
        $(`#tab-${t}`).addEventListener("click", () => showTab(t));
        $(`#side-${t}`).addEventListener("click", () => showTab(t));
      });
      $("#wrong-sort").addEventListener("change", renderWrongs);
      $("#gate-login").addEventListener("click", loginWithGoogle);

      // 관문의 "이 기기에 쌓인 오답노트" — localStorage만 읽는다(계정과 무관한 기기 기록)
      const paintLocalNote = () => {
        const rows = [...document.querySelectorAll<HTMLElement>(".local-row")];
        let any = false;
        rows.forEach((row) => {
          const note = loadNote(noteKey(row.dataset.slug ?? ""));
          const total = Object.keys(note).length;
          const due = dueIds(note).length;
          row.hidden = total === 0;
          if (total === 0) return;
          any = true;
          row.querySelector('[data-role="due"]')!.textContent = due ? `오늘 복습할 ${due}문제` : "오늘 몫 없음";
          row.querySelector('[data-role="total"]')!.textContent = `모두 ${total}문제`;
          row.classList.toggle("weak", due > 0);
        });
        $("#local-note").hidden = !any;
      };

      mountCodeCopy();

      onAuth((s) => {
        $("#gate").hidden = !!s;
        if (!s) paintLocalNote();
        $("#my").hidden = !s;
        $("#side-menu").hidden = !s; // 비로그인 관문에서는 사이드 메뉴도 숨긴다
        if (s) load();
      });
    </script>
  </body>
</html>
