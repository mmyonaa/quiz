---
import { EXAMS, EXAM_SLUGS } from "../content.config";
import { loadBank } from "../lib/bank";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

// 마이페이지 — DB에 쌓인 내 오답 기록·저장 문제를 보는 화면 (#7).
// 문제 본문·해설은 빌드 타임에 굽고, DB에서는 id·횟수·날짜만 온다.
const bank = await loadBank();

const BLOG_POST_BASE = "https://mmyonaa.github.io/blog/blog/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// 비로그인 관문이 "이 기기에 이미 쌓인 것"을 말하려면 시험별 저장 키를 알아야 한다
const EXAM_LIST = EXAMS.map((e) => ({ exam: e, slug: EXAM_SLUGS[e] ?? "", path: EXAM_SLUGS[e] ? `/${EXAM_SLUGS[e]}` : "" }));
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — 마이페이지</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta name="description" content="내 오답노트와 저장한 문제 — 계정에 영구 보관됩니다." />
  </head>
  <body>
    <SiteHeader current="my" />

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 보관함 메뉴(개념 노트의 사이드 목차와 같은 자리). 좁으면 상단 탭 */}
      <aside id="side-menu" class="side-toc" aria-label="보관함 메뉴" hidden>
        <span class="side-toc-title">보관함</span>
        <button id="side-wrong" class="side-link on" type="button">오답노트 <em data-count="wrong"></em></button>
        <button id="side-saved" class="side-link" type="button">저장한 문제 <em data-count="saved"></em></button>
        <button id="side-notes" class="side-link" type="button">저장한 개념 <em data-count="notes"></em></button>
      </aside>

      <div class="side-body">
      {/* 비로그인 관문 */}
      <section id="gate" class="panel flat" hidden>
        <h1>마이페이지</h1>
        <p class="lead">오답 기록과 저장한 문제는 계정에 보관됩니다. 로그인하면 어느 기기에서든 이어서 볼 수 있어요.</p>

        {/* 이 기기에 이미 쌓인 것 — 로그인의 이유를 추상적으로 말하는 대신 눈앞의 기록으로 말한다.
            비어 있으면 통째로 숨고, 관문은 원래의 문장 하나 + 버튼 하나로 돌아간다. */}
        <div id="local-note" class="local-note" hidden>
          <h2 class="group-title">이 기기에 쌓인 오답노트</h2>
          <div class="subjects">
            {EXAM_LIST.map(({ exam, slug, path }) => (
              <div class="subj local-row" data-slug={slug} hidden>
                <span class="subj-area">{exam}</span>
                <span class="subj-count" data-role="due"></span>
                <span class="subj-score" data-role="total"></span>
                <a class="weak-note" href={`${base}${path}/`}>풀러 가기 →</a>
              </div>
            ))}
          </div>
          <p class="my-hint">
            기기에만 있는 기록이라 브라우저를 지우면 함께 사라집니다. 로그인하면 계정에 남습니다.
          </p>
        </div>

        <button id="gate-login" class="primary" type="button">Google로 로그인</button>
      </section>

      <section id="my" class="panel flat" hidden>
        <h1>마이페이지</h1>
        <div class="tabs" role="tablist">
          <button id="tab-wrong" class="tab on" type="button" role="tab">오답노트 <em data-count="wrong"></em></button>
          <button id="tab-saved" class="tab" type="button" role="tab">저장한 문제 <em data-count="saved"></em></button>
          <button id="tab-notes" class="tab" type="button" role="tab">저장한 개념 <em data-count="notes"></em></button>
        </div>

        <div id="pane-wrong">
          <div class="my-toolbar">
            <span class="my-hint">채점 때 틀린 문제가 자동으로 쌓입니다.</span>
            <select id="wrong-sort" class="sort" aria-label="정렬">
              <option value="recent">최신 순</option>
              <option value="count">많이 틀린 순</option>
            </select>
          </div>
          <div id="wrong-list"></div>
          <p id="wrong-empty" class="empty" hidden>아직 오답 기록이 없습니다. 문제를 풀면 틀린 문제가 여기에 쌓여요.</p>
        </div>

        <div id="pane-saved" hidden>
          <div class="my-toolbar">
            <span class="my-hint">풀이 화면에서 ☆를 눌러 저장한 문제입니다.</span>
          </div>
          <div id="saved-list"></div>
          <p id="saved-empty" class="empty" hidden>저장한 문제가 없습니다. 풀이 중 ☆ 버튼으로 담아두세요.</p>
        </div>

        <div id="pane-notes" hidden>
          <div class="my-toolbar">
            <span class="my-hint">개념 노트에서 ☆를 눌러 저장한 개념입니다.</span>
          </div>
          <div id="notes-list"></div>
          <p id="notes-empty" class="empty" hidden>저장한 개념이 없습니다. 개념 노트에서 ☆ 버튼으로 담아두세요.</p>
        </div>
      </section>
      </div>
    </main>

    <script is:inline type="application/json" id="bank" set:html={JSON.stringify(bank)} />
    <script is:inline type="application/json" id="config" set:html={JSON.stringify({ blogPostBase: BLOG_POST_BASE })} />

    <script>
      import { supabase } from "../lib/supabase";
      import { onAuth, authSession, loginWithGoogle, errorText } from "../lib/auth";
      import { dueIds, loadNote, noteKey } from "../lib/wrong-note";

      type Q = {
        id: string;
        area: string;
        difficulty: string;
        question: string;
        code?: string;
        choices: string[];
        answer: number;
        explanation: string;
        relatedPost?: string; // 선택 — 글이 아직 없는 문항은 링크 없이 렌더
      };
      type WrongRow = { question_id: string; chosen: number; answered_at: string };
      type WrongItem = { q: Q; count: number; lastChosen: number; lastAt: string };

      const bank: Q[] = JSON.parse(document.getElementById("bank")!.textContent!);
      const { blogPostBase } = JSON.parse(document.getElementById("config")!.textContent!) as { blogPostBase: string };
      const bankById = new Map(bank.map((q) => [q.id, q]));

      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;
      // 상단 탭·사이드 메뉴 양쪽의 건수 표시를 한 번에 갱신
      const setCount = (key: string, n: number) =>
        document.querySelectorAll(`[data-count="${key}"]`).forEach((el) => (el.textContent = String(n)));

      let wrongs: WrongItem[] = [];
      let saved: Q[] = [];
      let notes: Q[] = [];

      const fmtDate = (iso: string) =>
        new Date(iso).toLocaleDateString("ko-KR", { year: "numeric", month: "long", day: "numeric" });

      const card = (q: Q, metaHTML: string) => {
        const el = document.createElement("article");
        el.className = "rv wrong";
        const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        el.innerHTML = `
          <p class="rv-q"><span class="badge">${q.area}</span> <span class="badge diff" data-level="${q.difficulty}">${q.difficulty}</span> ${q.question}</p>
          ${q.code ? `<pre class="q-code mono">${esc(q.code)}</pre>` : ""}
          ${metaHTML}
          <p class="rv-a">정답: <b>${q.choices[q.answer]}</b></p>
          <p class="rv-x">${q.explanation}</p>
          ${q.relatedPost ? `<p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>` : ""}
        `;
        return el;
      };

      const renderWrongs = () => {
        const sort = ($("#wrong-sort") as HTMLSelectElement).value;
        const items = [...wrongs].sort((a, b) =>
          sort === "count" ? b.count - a.count || b.lastAt.localeCompare(a.lastAt) : b.lastAt.localeCompare(a.lastAt),
        );
        setCount("wrong", items.length);
        $("#wrong-empty").hidden = items.length > 0;
        const list = $("#wrong-list");
        list.innerHTML = "";
        items.forEach((it) => {
          const meta = `
            <p class="rv-meta mono">${it.count}회 틀림 · 마지막 ${fmtDate(it.lastAt)}</p>
            <p class="rv-a">내 답: ${it.q.choices[it.lastChosen] ?? "?"}</p>`;
          const el = card(it.q, meta);
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "기록 삭제";
          del.addEventListener("click", async () => {
            if (!confirm("이 문제의 오답 기록을 모두 삭제할까요?")) return;
            const { error } = await supabase
              .from("wrong_answers")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", it.q.id);
            if (error) {
              alert(errorText("삭제에 실패했습니다", error));
              return;
            }
            wrongs = wrongs.filter((w) => w.q.id !== it.q.id);
            renderWrongs();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      const renderSaved = () => {
        setCount("saved", saved.length);
        $("#saved-empty").hidden = saved.length > 0;
        const list = $("#saved-list");
        list.innerHTML = "";
        saved.forEach((q) => {
          const el = card(q, "");
          el.className = "rv"; // 저장 목록은 오답 색을 쓰지 않는다
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "저장 해제";
          del.addEventListener("click", async () => {
            const { error } = await supabase
              .from("saved_questions")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", q.id);
            if (error) {
              alert(errorText("해제에 실패했습니다", error));
              return;
            }
            saved = saved.filter((s) => s.id !== q.id);
            renderSaved();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      // 저장한 개념 — 개념 노트처럼 해설을 앞세워 렌더
      const renderNotes = () => {
        setCount("notes", notes.length);
        $("#notes-empty").hidden = notes.length > 0;
        const list = $("#notes-list");
        list.innerHTML = "";
        notes.forEach((q) => {
          const el = document.createElement("article");
          el.className = "rv note";
          el.innerHTML = `
            <p class="rv-x"><span class="badge">${q.area}</span> ${q.explanation}</p>
            <p class="rv-link"><a href="${blogPostBase}${q.relatedPost}/" target="_blank" rel="noopener">개념 글 다시 읽기 →</a></p>
          `;
          const del = document.createElement("button");
          del.type = "button";
          del.className = "linklike rv-del";
          del.textContent = "저장 해제";
          del.addEventListener("click", async () => {
            const { error } = await supabase
              .from("saved_notes")
              .delete()
              .eq("user_id", authSession()!.user.id)
              .eq("question_id", q.id);
            if (error) {
              alert(errorText("해제에 실패했습니다", error));
              return;
            }
            notes = notes.filter((x) => x.id !== q.id);
            renderNotes();
          });
          el.appendChild(del);
          list.appendChild(el);
        });
      };

      const load = async () => {
        const [w, s, n] = await Promise.all([
          supabase.from("wrong_answers").select("question_id, chosen, answered_at").order("answered_at", { ascending: false }),
          supabase.from("saved_questions").select("question_id, created_at").order("created_at", { ascending: false }),
          supabase.from("saved_notes").select("question_id, created_at").order("created_at", { ascending: false }),
        ]);
        if (w.error || s.error) {
          alert(errorText("기록을 불러오지 못했습니다", (w.error ?? s.error)!));
          return;
        }
        // saved_notes는 스키마 추가분 — 미적용 DB에서도 나머지 탭은 동작해야 한다
        if (n.error) console.error("저장한 개념 조회 실패:", n.error.message);
        notes = n.error
          ? []
          : (n.data as { question_id: string }[]).map((r) => bankById.get(r.question_id)).filter((q): q is Q => !!q);
        renderNotes();
        // question_id로 묶기 — 내림차순이라 첫 등장이 최신 기록
        const byId = new Map<string, WrongItem>();
        (w.data as WrongRow[]).forEach((r) => {
          const q = bankById.get(r.question_id);
          if (!q) return; // 은행에서 빠진 문제는 표시하지 않는다
          const it = byId.get(r.question_id);
          if (it) it.count++;
          else byId.set(r.question_id, { q, count: 1, lastChosen: r.chosen, lastAt: r.answered_at });
        });
        wrongs = [...byId.values()];
        saved = (s.data as { question_id: string }[]).map((r) => bankById.get(r.question_id)).filter((q): q is Q => !!q);
        renderWrongs();
        renderSaved();
      };

      // 탭 전환 — 상단 탭과 좌측 사이드 메뉴가 같은 상태를 공유한다
      const TABS = ["wrong", "saved", "notes"] as const;
      const showTab = (tab: (typeof TABS)[number]) => {
        TABS.forEach((t) => {
          $(`#tab-${t}`).classList.toggle("on", t === tab);
          $(`#side-${t}`).classList.toggle("on", t === tab);
          $(`#pane-${t}`).hidden = t !== tab;
        });
      };
      TABS.forEach((t) => {
        $(`#tab-${t}`).addEventListener("click", () => showTab(t));
        $(`#side-${t}`).addEventListener("click", () => showTab(t));
      });
      $("#wrong-sort").addEventListener("change", renderWrongs);
      $("#gate-login").addEventListener("click", loginWithGoogle);

      // 관문의 "이 기기에 쌓인 오답노트" — localStorage만 읽는다(계정과 무관한 기기 기록)
      const paintLocalNote = () => {
        const rows = [...document.querySelectorAll<HTMLElement>(".local-row")];
        let any = false;
        rows.forEach((row) => {
          const note = loadNote(noteKey(row.dataset.slug ?? ""));
          const total = Object.keys(note).length;
          const due = dueIds(note).length;
          row.hidden = total === 0;
          if (total === 0) return;
          any = true;
          row.querySelector('[data-role="due"]')!.textContent = due ? `오늘 복습할 ${due}문제` : "오늘 몫 없음";
          row.querySelector('[data-role="total"]')!.textContent = `모두 ${total}문제`;
          row.classList.toggle("weak", due > 0);
        });
        $("#local-note").hidden = !any;
      };

      onAuth((s) => {
        $("#gate").hidden = !!s;
        if (!s) paintLocalNote();
        $("#my").hidden = !s;
        $("#side-menu").hidden = !s; // 비로그인 관문에서는 사이드 메뉴도 숨긴다
        if (s) load();
      });
    </script>
  </body>
</html>
