---
import { getCollection } from "astro:content";
import { AREAS } from "../content.config";
import postTitles from "../data/post-titles.json";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

// 개념 노트 — 문제 은행의 해설을 영역별 → 개념 글(주제)별로 모아 읽는 정적 페이지.
// 풀이 없이 개념만 훑고, 각 개념의 원 문항은 '확인 문제'로 접어 복습에 쓴다.
const entries = await getCollection("quiz");
const bank = entries.map((e) => e.data);

const BLOG_POST_BASE = "https://mmyonaa.github.io/blog/blog/";
const titles: Record<string, string> = postTitles;

// 영역 → 주제(개념 글) → 문항. 주제는 은행 안 등장 순서를 유지한다.
const byArea = AREAS.map((area) => {
  const qs = bank.filter((q) => q.area === area);
  const topics = [...new Set(qs.map((q) => q.relatedPost))].map((post) => ({
    post,
    title: titles[post] ?? post.replace(/^\d{4}-\d{2}-\d{2}-/, ""),
    questions: qs.filter((q) => q.relatedPost === post),
  }));
  return { area, count: qs.length, topics };
});

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>daily.quiz — 개념 노트</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content="정보처리기사 필기 문제 은행의 해설을 영역별·개념별로 모아 읽는 개념 노트. 각 개념은 확인 문제와 daily.mcp 개념 글로 이어집니다."
    />
  </head>
  <body>
    <SiteHeader current="notes" />

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 고정 목차. 좁은 화면은 상단 칩(.toc)이 담당 */}
      <aside class="side-toc" aria-label="영역 바로가기">
        <span class="side-toc-title">영역</span>
        {byArea.map(({ area, count }) => (
          <a class="side-link" href={`#${area}`} data-area={area}>{area} <em>{count}</em></a>
        ))}
      </aside>

      <div class="side-body">
      <section class="panel">
        <h1>개념 노트</h1>
        <p class="lead">
          문제 은행 {bank.length}문항의 해설을 개념별로 모았습니다.
          훑어 읽다가 '확인 문제'를 펼쳐 스스로 점검하고, 더 깊게는 개념 글로 이어가세요.
        </p>
        <nav class="toc">
          {byArea.map(({ area, count }) => (
            <a class="toc-chip" href={`#${area}`}>{area} <em>{count}</em></a>
          ))}
        </nav>
      </section>

      {byArea.map(({ area, topics }) => (
        <section class="panel" id={area}>
          <h2 class="area-title">{area}</h2>
          {topics.map(({ post, title, questions }) => (
            <div class="topic">
              <h3 class="topic-title">
                {title}
                <a class="topic-link" href={`${BLOG_POST_BASE}${post}/`} target="_blank" rel="noopener">개념 글 →</a>
              </h3>
              {questions.map((q) => (
                <article class="cn" data-id={q.id}>
                  <button class="save-star cn-save" type="button" title="이 개념 저장" aria-label="이 개념 저장">☆</button>
                  <p class="cn-x">{q.explanation}</p>
                  <details class="cn-q">
                    <summary>확인 문제</summary>
                    <p class="cn-question">{q.question}</p>
                    <ol class="cn-choices">
                      {q.choices.map((c, i) => (
                        <li class={i === q.answer ? "ans" : ""}>{c}</li>
                      ))}
                    </ol>
                  </details>
                </article>
              ))}
            </div>
          ))}
        </section>
      ))}
      </div>
    </main>

    <script>
      import { supabase } from "../lib/supabase";
      import { onAuth, authSession, requireLogin } from "../lib/auth";

      // ── 개념 저장(북마크) — saved_notes 테이블, 해설 카드(문항 id) 단위 ──
      let savedNotes = new Set<string>();
      const stars = [...document.querySelectorAll<HTMLButtonElement>(".cn-save")];
      const idOf = (b: HTMLElement) => (b.closest(".cn") as HTMLElement).dataset.id!;

      const paintStars = () => {
        stars.forEach((b) => {
          const on = savedNotes.has(idOf(b));
          b.textContent = on ? "★" : "☆";
          b.classList.toggle("on", on);
        });
      };

      onAuth(async (s) => {
        if (!s) {
          savedNotes = new Set();
          paintStars();
          return;
        }
        const { data, error } = await supabase.from("saved_notes").select("question_id");
        if (error) {
          // 테이블 미적용 등 — 노트 읽기는 계속되어야 하므로 조용히 로그만
          console.error("저장한 개념 조회 실패:", error.message);
          return;
        }
        savedNotes = new Set((data ?? []).map((r: { question_id: string }) => r.question_id));
        paintStars();
      });

      stars.forEach((b) =>
        b.addEventListener("click", async () => {
          if (!requireLogin()) return;
          const id = idOf(b);
          const uid = authSession()!.user.id;
          const wasSaved = savedNotes.has(id);
          if (wasSaved) savedNotes.delete(id);
          else savedNotes.add(id);
          paintStars(); // 낙관적 반영, 실패 시 되돌림
          const { error } = wasSaved
            ? await supabase.from("saved_notes").delete().eq("user_id", uid).eq("question_id", id)
            : await supabase.from("saved_notes").upsert({ user_id: uid, question_id: id });
          if (error) {
            if (wasSaved) savedNotes.add(id);
            else savedNotes.delete(id);
            paintStars();
            alert(`저장에 실패했습니다: ${error.message}`);
          }
        }),
      );

      // 스크롤스파이 — 화면 상단을 지난 마지막 영역을 사이드 목차에 하이라이트
      const links = [...document.querySelectorAll<HTMLAnchorElement>(".side-link")];
      const sections = [...document.querySelectorAll<HTMLElement>("section[id]")];
      if (links.length && sections.length) {
        const byArea = new Map(links.map((a) => [a.dataset.area, a]));
        let ticking = false;
        const spy = () => {
          ticking = false;
          let cur = sections[0].id;
          for (const s of sections) if (s.getBoundingClientRect().top <= 120) cur = s.id;
          links.forEach((a) => a.classList.toggle("on", a === byArea.get(cur)));
        };
        document.addEventListener(
          "scroll",
          () => {
            if (!ticking) {
              ticking = true;
              requestAnimationFrame(spy);
            }
          },
          { passive: true },
        );
        spy();
      }
    </script>

    <SiteFooter />
  </body>
</html>
