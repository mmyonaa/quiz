---
import { AREAS, AREA_SLUGS, DIFFICULTIES } from "../../content.config";
import { loadBank, loadPractical, topicsOf } from "../../lib/bank";
import NoteTopics from "../../components/NoteTopics.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

// 개념 노트 영역 상세 — 한 영역의 해설을 개념 글(주제)별로 읽는 페이지.
// URL은 한글 인코딩을 피해 영문 슬러그(/notes/os/ 등)를 쓴다.
export function getStaticPaths() {
  return AREAS.map((area) => ({ params: { area: AREA_SLUGS[area] }, props: { area } }));
}

const { area } = Astro.props as { area: (typeof AREAS)[number] };

const bank = await loadBank();
// 실기 문항도 같은 주제에 붙는다 — 개념 노트는 필기·실기를 나누지 않고 주제 하나로 모은다.
const pbank = await loadPractical();

const qs = bank.filter((q) => q.area === area);
const ps = pbank.filter((q) => q.area === area);
// 주제 순서는 topic-notes.json의 정의 순서(기초 → 심화)를 따른다.
const topics = topicsOf(area).map((t) => ({
  ...t,
  questions: qs.filter((q) => q.topic === t.key),
  practical: ps.filter((q) => q.topic === t.key),
}));

const countByArea = Object.fromEntries(AREAS.map((a) => [a, bank.filter((q) => q.area === a).length]));
// 난이도 칩은 이 페이지에 실제로 놓인 카드 수와 맞아야 한다 — 필기 해설 + 실기 확인 문제
const cards = [...qs, ...ps];
const countByDiff = Object.fromEntries(DIFFICULTIES.map((d) => [d, cards.filter((q) => q.difficulty === d).length]));
const idx = AREAS.indexOf(area);
const prevArea = idx > 0 ? AREAS[idx - 1] : null;
const nextArea = idx < AREAS.length - 1 ? AREAS[idx + 1] : null;

const BLOG_POST_BASE = "https://mmyonaa.github.io/blog/blog/";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — 개념 노트 · {area}</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content={`정보처리기사 필기 ${area} 영역의 개념 노트 — 해설 ${qs.length}문항을 개념별로 모아 읽고 확인 문제로 점검합니다.`}
    />
  </head>
  <body>
    <SiteHeader current="notes" toc="영역" />

    {/* 읽기 진행률 — 화면 최상단 얇은 바 */}
    <div class="read-progress" aria-hidden="true"><i id="read-fill"></i></div>

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 영역 메뉴, 현재 영역 하이라이트 */}
      <aside id="side-toc" class="side-toc as-drawer" aria-label="영역 바로가기">
        {/* 좁은 화면에선 헤더의 '목차' 버튼으로 여는 좌측 드로어가 된다 */}
        <button id="toc-close" class="toc-close" type="button" aria-label="목차 닫기">×</button>
        <span class="side-toc-title">영역</span>
        <a class="side-link" href={`${base}/notes/`}>전체 <em>{bank.length}</em></a>
        {AREAS.map((a) =>
          a === area ? (
            <>
              <a class="side-link on" href={`${base}/notes/${AREA_SLUGS[a]}/`} aria-current="page">
                {a} <em>{countByArea[a]}</em>
              </a>
              {/* 현재 영역의 세부 주제 — 큰 영역 밑의 작은 분야까지 한눈에 */}
              <nav class="side-sub" aria-label={`${a} 주제 바로가기`}>
                {topics.map(({ title }, i) => (
                  <a class="side-sublink" href={`#t${i}`}>{title.split(" — ")[0]}</a>
                ))}
              </nav>
            </>
          ) : (
            <a class="side-link" href={`${base}/notes/${AREA_SLUGS[a]}/`}>{a} <em>{countByArea[a]}</em></a>
          ),
        )}
      </aside>

      <div class="side-body">
        <section class="panel">
          <h1>{area}</h1>
          <p class="lead">
            <a class="lead-link" href={`${base}/notes/`}>개념 노트</a> 안의 {area} 영역 —
            해설 {qs.length}문항을 {topics.length}개 주제로 모았습니다.
            {ps.length > 0 && <> 같은 주제에 실기 확인 문제 {ps.length}개가 함께 붙어 있습니다.</>}
          </p>
          {/* 좁은 화면 전용 — 영역 이동 칩(한 줄 가로 스크롤) */}
          <nav class="toc" aria-label="영역 이동">
            {AREAS.map((a) => (
              <a class={`toc-chip${a === area ? " on" : ""}`} href={`${base}/notes/${AREA_SLUGS[a]}/`}>
                {a} <em>{countByArea[a]}</em>
              </a>
            ))}
          </nav>
          {/* 주제 바로가기 — 데스크톱·모바일 공용. 영역·필터 칩과 혼동되지 않게 해시 링크풍 */}
          <details class="topic-jumps-box">
            <summary>주제 {topics.length}개 바로가기</summary>
            <nav class="topic-jumps" aria-label="주제 바로가기">
              {topics.map(({ title }, i) => (
                <a class="topic-jump" href={`#t${i}`}>{title}</a>
              ))}
            </nav>
          </details>
          {/* 난이도 필터 + 모두 펼치기 */}
          <div class="note-tools">
            <div class="chip-row" role="group" aria-label="난이도 필터">
              <button class="toc-chip diff-chip on" type="button" data-diff="전체">전체 <em>{cards.length}</em></button>
              {DIFFICULTIES.map((d) => (
                <button class="toc-chip diff-chip" type="button" data-diff={d}>{d} <em>{countByDiff[d]}</em></button>
              ))}
            </div>
            <button id="toggle-all" class="linklike" type="button">모두 펼치기</button>
          </div>
        </section>

        <section class="panel">
          <NoteTopics topics={topics} blogPostBase={BLOG_POST_BASE} />

          {/* 이전/다음 영역 이동 */}
          <nav class="area-nav">
            {prevArea ? (
              <a href={`${base}/notes/${AREA_SLUGS[prevArea]}/`}><small>이전 영역</small>← {prevArea}</a>
            ) : (
              <a href={`${base}/notes/`}><small>목차</small>← 전체 영역</a>
            )}
            {nextArea ? (
              <a class="next" href={`${base}/notes/${AREA_SLUGS[nextArea]}/`}><small>다음 영역</small>{nextArea} →</a>
            ) : (
              <a class="next" href={`${base}/notes/`}><small>목차</small>전체 영역 →</a>
            )}
          </nav>
        </section>
      </div>
    </main>


    <SiteFooter />
  </body>
</html>
