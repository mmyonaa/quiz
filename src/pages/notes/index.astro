---
import { AREAS, AREA_SLUGS, SUBJECTS, SUBJECT_SLUGS } from "../../content.config";
import { loadBank, loadPractical, topicsOf, topicsOfSubject, areasOfSubject } from "../../lib/bank";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import "../../styles/global.css";

// 개념 노트 목차 — 영역별 상세 페이지(/notes/<slug>/)로 이어지는 관문.
// 본문이 계속 늘어나므로 한 페이지에 다 싣지 않고 영역 단위로 라우팅을 나눈다.
const bank = await loadBank();
// 실기 문항도 같은 주제에 붙으므로 어느 영역·과목에 몇 개가 붙어 있는지 함께 보여준다
const pbank = await loadPractical();

const areas = AREAS.map((area) => {
  const topics = topicsOf(area);
  return {
    area,
    slug: AREA_SLUGS[area],
    count: bank.filter((q) => q.area === area).length,
    practicalCount: pbank.filter((q) => q.area === area).length,
    topicCount: topics.length,
    preview: topics.slice(0, 3).map((t) => t.title),
  };
});

// 시험 과목 — 영역보다 한 단계 위. 과목과 영역은 다대다라 과목 안에 걸친 영역을 함께 보여준다.
const subjects = SUBJECTS.map((subject, i) => ({
  subject,
  no: i + 1,
  slug: SUBJECT_SLUGS[subject],
  count: bank.filter((q) => q.subject === subject).length,
  practicalCount: pbank.filter((q) => q.subject === subject).length,
  topics: topicsOfSubject(subject),
  areas: areasOfSubject(subject),
}));

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>daily.quiz — 개념 노트</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta
      name="description"
      content="정보처리기사 필기 문제 은행의 해설을 영역별·개념별로 모아 읽는 개념 노트. 각 개념은 확인 문제와 daily.mcp 개념 글로 이어집니다."
    />
  </head>
  <body>
    <SiteHeader current="notes" />

    <main class="side-layout">
      {/* 넓은 화면 전용 — 좌측 영역 메뉴. 목차 페이지에서는 '전체'가 현재 위치 */}
      <aside class="side-toc" aria-label="영역 바로가기">
        <span class="side-toc-title">영역</span>
        <a class="side-link on" href={`${base}/notes/`}>전체 <em>{bank.length}</em></a>
        {areas.map(({ area, slug, count }) => (
          <a class="side-link" href={`${base}/notes/${slug}/`}>{area} <em>{count}</em></a>
        ))}
      </aside>

      <div class="side-body">
        <section class="panel">
          <h1>개념 노트</h1>
          <p class="lead">
            문제 은행 {bank.length}문항의 해설을 개념별로 모았습니다.
            실제 시험 과목으로 훑거나, 아래 영역으로 들어가 읽다가 '확인 문제'를 펼쳐
            스스로 점검하고, 더 깊게는 개념 글로 이어가세요.
            개념은 필기·실기를 나누지 않습니다 — 같은 주제 아래
            <a class="lead-link" href={`${base}/practical/`}>실기 확인 문제</a> {pbank.length}개가 함께 붙어 있습니다.
          </p>

          {/* 시험 과목 — 실제 필기의 5과목. 영역보다 한 단계 위 */}
          <h2 class="group-title">시험 과목</h2>
          <div class="subject-cards">
            {subjects.map(({ subject, no, slug, count, practicalCount, topics, areas: sAreas }) => (
              <a class="subject-card" href={`${base}/notes/s/${slug}/`}>
                <h3>
                  <span class="subj-no">{no}과목</span> {subject} <em>{count}문항</em>
                  {practicalCount > 0 && <span class="topic-pa-badge">실기 {practicalCount}</span>}
                </h3>
                <p class="ac-meta">{topics.length}개 주제 · {sAreas.join(" · ")}</p>
              </a>
            ))}
          </div>

          <h2 class="group-title">영역</h2>
          <div class="area-cards">
            {areas.map(({ area, slug, count, practicalCount, topicCount, preview }) => (
              <a class="area-card" href={`${base}/notes/${slug}/`}>
                <h2>
                  {area} <em>{count}문항</em>
                  {practicalCount > 0 && <span class="topic-pa-badge">실기 {practicalCount}</span>}
                </h2>
                <p class="ac-meta">
                  {topicCount}개 주제{preview.length > 0 && ` — ${preview.join(" · ")}${topicCount > preview.length ? " …" : ""}`}
                </p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </main>

    {/* 예전 단일 페이지 시절의 #영역 앵커 링크 호환 — 영역 상세로 보낸다 */}
    <script is:inline define:vars={{ slugMap: AREA_SLUGS, base }}>
      const area = decodeURIComponent(location.hash.slice(1));
      if (slugMap[area]) location.replace(`${base}/notes/${slugMap[area]}/`);
    </script>

    <SiteFooter />
  </body>
</html>
