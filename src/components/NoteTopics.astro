---
import type { DIFFICULTIES } from "../content.config";

// 개념 노트 본문 — 주제 카드 목록과 그 상호작용(개념 저장·확인 문제·난이도 필터·
// 모두 펼치기·읽기 진행률). 영역 페이지와 과목 페이지가 같은 화면을 쓰므로 여기로 모았다.
type Q = {
  id: string;
  difficulty: (typeof DIFFICULTIES)[number];
  question: string;
  code?: string;
  choices: string[];
  answer: number;
  explanation: string;
};
/** 실기 문항 — 같은 주제에 붙어 "고르기" 다음에 "직접 쓰기"로 이어지는 사다리를 만든다 */
type PQ = {
  id: string;
  difficulty: (typeof DIFFICULTIES)[number];
  kind: string;
  question: string;
  code?: string;
  answers: string[][];
  labels?: string[];
  modelAnswer?: string;
  keywords?: string[];
  explanation: string;
};
const { topics, blogPostBase } = Astro.props as {
  topics: {
    post?: string;
    title: string;
    intro: string;
    questions: Q[];
    practical?: PQ[];
  }[];
  blogPostBase: string;
};

/** 답란 이름 — 다답형은 ①② 같은 라벨이 있고, 단일 답란은 그냥 "정답" */
const blankLabel = (q: PQ, i: number) =>
  q.labels?.[i] ?? (q.answers.length > 1 ? `${i + 1}번 답란` : "정답");
---

{topics.map(({ post, title, intro, questions, practical = [] }, i) => (
    <div class="topic" id={`t${i}`}>
      <h3 class="topic-title">
        <span class="topic-name">{title}</span>
        {/* 실기 출제 형태 — practical.json에서 주제별 유형을 모아 보여준다(별도 데이터 없음).
            "이 주제는 실기에서 코드형으로 나온다"를 개념을 읽는 자리에서 바로 알 수 있다. */}
        {[...new Set(practical.map((p) => p.kind))].map((k) => (
          <span class="topic-pa-badge">실기 {k}</span>
        ))}
        {post && (
          <a class="topic-link" href={`${blogPostBase}${post}/`} target="_blank" rel="noopener">개념 글 →</a>
        )}
      </h3>
      {/* 개념 도입부 — 문제 전제 없이 읽히는 자족적 정의·핵심 정리.
          topic-notes.json의 빈 줄이 문단 경계다. "- "로 시작하는 덩어리는 목록으로 편다 —
          "A는 …, B는 …, C는 …" 식 열거는 산문보다 목록이 훨씬 빨리 읽힌다. */}
      <div class="topic-intro">
        {intro.split("\n\n").map((block) =>
          block.startsWith("- ") ? (
            <ul>{block.split("\n").map((li) => <li>{li.slice(2)}</li>)}</ul>
          ) : (
            <p>{block}</p>
          ),
        )}
      </div>
      {questions.map((q) => (
        <article class="cn" data-id={q.id} data-diff={q.difficulty}>
          <button class="save-star cn-save" type="button" title="이 개념 저장" aria-label="이 개념 저장">☆</button>
          <p class="cn-x">{q.explanation}</p>
          <details class="cn-q">
            <summary>확인 문제 <span class="badge diff" data-level={q.difficulty}>{q.difficulty}</span></summary>
            <p class="cn-question">{q.question}</p>
            {q.code && <pre class="q-code mono">{q.code}</pre>}
            {/* 정답은 가려져 있다 — 선지를 골라 자기 점검하거나 '정답만 보기' */}
            <ol class="cn-choices" data-answer={q.answer}>
              {q.choices.map((c) => (
                <li><button type="button" class="cn-choice">{c}</button></li>
              ))}
            </ol>
            <button type="button" class="linklike cn-reveal">정답만 보기</button>
          </details>
        </article>
      ))}

      {/* 실기 확인 문제 — 보기 없이 직접 써 보는 자리. 필기 확인 문제가 "알아보기"라면 이쪽은 "떠올리기"다. */}
      {practical.map((p) => (
        <article class="cn cn-pa" data-diff={p.difficulty}>
          <details class="cn-q">
            <summary>
              실기 확인 문제
              <span class="badge">{p.kind}</span>
              <span class="badge diff" data-level={p.difficulty}>{p.difficulty}</span>
            </summary>
            <p class="cn-question">{p.question}</p>
            {p.code && <pre class="q-code mono">{p.code}</pre>}
            <button type="button" class="linklike cn-pa-reveal">정답 보기</button>
            <div class="cn-pa-ans" hidden>
              {p.kind === "약술형" ? (
                <>
                  {/* 서술형 답안은 길어서 라벨을 같은 줄에 두면 둘째 줄부터 들여쓰기가 어긋난다 */}
                  <p class="cn-pa-line stacked"><span class="cn-pa-key">모범답안</span>{p.modelAnswer}</p>
                  {p.keywords?.length && (
                    <p class="cn-pa-alt">핵심어 — {p.keywords.join(" · ")}</p>
                  )}
                </>
              ) : (
                <>
                  {p.answers.map((acc, b) => (
                    <p class="cn-pa-line">
                      <span class="cn-pa-key">{blankLabel(p, b)}</span>
                      <strong class="mono">{acc[0]}</strong>
                    </p>
                  ))}
                  {p.answers.some((a) => a.length > 1) && (
                    <p class="cn-pa-alt">
                      함께 정답 처리되는 표기 — {p.answers.map((a) => a.slice(1).join(", ")).filter(Boolean).join(" / ")}
                    </p>
                  )}
                </>
              )}
              <p class="cn-x cn-pa-exp">{p.explanation}</p>
            </div>
          </details>
        </article>
      ))}
    </div>
  ))}


    <script>
      import { supabase } from "../lib/supabase";
      import { onAuth, authSession, requireLogin, errorText } from "../lib/auth";
      import { toast } from "../lib/toast";

      const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;

      // ── 개념 저장(북마크) — saved_notes 테이블, 해설 카드(문항 id) 단위 ──
      let savedNotes = new Set<string>();
      const stars = [...document.querySelectorAll<HTMLButtonElement>(".cn-save")];
      const idOf = (b: HTMLElement) => (b.closest(".cn") as HTMLElement).dataset.id!;

      const paintStars = () => {
        stars.forEach((b) => {
          const on = savedNotes.has(idOf(b));
          b.textContent = on ? "★" : "☆";
          b.classList.toggle("on", on);
        });
      };

      onAuth(async (s) => {
        if (!s) {
          savedNotes = new Set();
          paintStars();
          return;
        }
        const { data, error } = await supabase.from("saved_notes").select("question_id");
        if (error) {
          // 테이블 미적용 등 — 노트 읽기는 계속되어야 하므로 조용히 로그만
          console.error("저장한 개념 조회 실패:", error.message);
          return;
        }
        savedNotes = new Set((data ?? []).map((r: { question_id: string }) => r.question_id));
        paintStars();
      });

      stars.forEach((b) =>
        b.addEventListener("click", async () => {
          if (!requireLogin()) return;
          const id = idOf(b);
          const uid = authSession()!.user.id;
          const wasSaved = savedNotes.has(id);
          if (wasSaved) savedNotes.delete(id);
          else savedNotes.add(id);
          paintStars(); // 낙관적 반영, 실패 시 되돌림
          const { error } = wasSaved
            ? await supabase.from("saved_notes").delete().eq("user_id", uid).eq("question_id", id)
            : await supabase.from("saved_notes").upsert({ user_id: uid, question_id: id });
          if (error) {
            if (wasSaved) savedNotes.add(id);
            else savedNotes.delete(id);
            paintStars();
            alert(errorText("저장에 실패했습니다", error));
            return;
          }
          toast(wasSaved ? "저장을 해제했습니다" : "저장했습니다 · 마이페이지에 모아둡니다");
        }),
      );

      // ── 확인 문제 — 정답은 가린 채 시작, 선지 선택 또는 '정답만 보기'로 공개 ──
      document.querySelectorAll<HTMLOListElement>(".cn-choices").forEach((ol) => {
        const answer = Number(ol.dataset.answer);
        const revealBtn = ol.parentElement!.querySelector<HTMLElement>(".cn-reveal");
        const reveal = (chosen: number | null) => {
          if (ol.classList.contains("done")) return;
          ol.classList.add("done");
          [...ol.children].forEach((li, i) => {
            li.classList.toggle("ans", i === answer);
            if (chosen !== null && chosen !== answer && i === chosen) li.classList.add("bad");
          });
          if (revealBtn) revealBtn.hidden = true;
        };
        [...ol.querySelectorAll<HTMLButtonElement>(".cn-choice")].forEach((b, i) =>
          b.addEventListener("click", () => reveal(i)),
        );
        revealBtn?.addEventListener("click", () => reveal(null));
      });

      // ── 실기 확인 문제 — 보기가 없으므로 답을 떠올린 뒤 펼쳐 대조한다 ──
      document.querySelectorAll<HTMLButtonElement>(".cn-pa-reveal").forEach((btn) => {
        btn.addEventListener("click", () => {
          (btn.nextElementSibling as HTMLElement).hidden = false;
          btn.hidden = true;
        });
      });

      // ── 난이도 필터 — 카드 숨김, 빈 주제는 통째로 숨김 ──
      const diffChips = [...document.querySelectorAll<HTMLButtonElement>(".diff-chip")];
      const cards = [...document.querySelectorAll<HTMLElement>(".cn")];
      const topicEls = [...document.querySelectorAll<HTMLElement>(".topic")];
      diffChips.forEach((chip) =>
        chip.addEventListener("click", () => {
          const d = chip.dataset.diff!;
          diffChips.forEach((c) => c.classList.toggle("on", c === chip));
          cards.forEach((c) => (c.hidden = d !== "전체" && c.dataset.diff !== d));
          topicEls.forEach((t) => (t.hidden = ![...t.querySelectorAll<HTMLElement>(".cn")].some((c) => !c.hidden)));
          // 숨은 주제는 사이드 목록에서도 빠진다 — 없는 곳으로 보내는 링크는 죽은 링크다
          subLinks.forEach((a, i) => (a.hidden = topicEls[i]?.hidden ?? false));
          spyAt = -1;
          spy();
        }),
      );

      // ── 모두 펼치기/접기 ──
      const toggleAll = $("#toggle-all") as HTMLButtonElement;
      let allOpen = false;
      toggleAll.addEventListener("click", () => {
        allOpen = !allOpen;
        document.querySelectorAll<HTMLDetailsElement>(".cn-q").forEach((d) => (d.open = allOpen));
        toggleAll.textContent = allOpen ? "모두 접기" : "모두 펼치기";
      });

      // ── 사이드 목차 스크롤 스파이 — 지금 읽는 주제를 좌측 세부 목록에서 표시 ──
      const sideToc = document.querySelector<HTMLElement>(".side-toc");
      const subLinks = [...document.querySelectorAll<HTMLAnchorElement>(".side-sub.current .side-sublink")];
      let spyAt = -1;
      const spy = () => {
        if (!subLinks.length) return;
        // 화면 위쪽 140px 선을 지난 마지막 주제가 '지금 읽는 주제'
        const line = 140;
        // 첫 화면에서는(또는 필터로 앞 주제가 사라졌으면) 보이는 첫 주제가 기준
        let cur = topicEls.findIndex((t) => !t.hidden);
        if (cur < 0) return;
        topicEls.forEach((t, i) => {
          if (!t.hidden && t.getBoundingClientRect().top <= line) cur = i;
        });
        if (cur === spyAt) return;
        spyAt = cur;
        subLinks.forEach((a, i) => a.classList.toggle("on", i === cur));
        // 목차가 자체 스크롤 중이면 현재 항목을 시야 안으로(페이지는 건드리지 않는다).
        // 시야는 목차 전체가 아니다 — 위아래로 고정된 영역 줄이 가리므로, 현재 영역 줄의
        // 아래부터 다음 영역 줄의 위까지가 주제가 실제로 보이는 구간이다.
        if (sideToc && sideToc.scrollHeight > sideToc.clientHeight) {
          const el = subLinks[cur];
          const wrap = el.closest(".side-sub-wrap");
          const box = sideToc.getBoundingClientRect();
          const above = Math.max(wrap?.previousElementSibling?.getBoundingClientRect().bottom ?? box.top, box.top);
          const below = Math.min(wrap?.nextElementSibling?.getBoundingClientRect().top ?? box.bottom, box.bottom);
          const r = el.getBoundingClientRect();
          if (r.top < above) sideToc.scrollTop -= above - r.top;
          else if (r.bottom > below) sideToc.scrollTop += r.bottom - below;
        }
      };

      // ── 읽기 진행률 + 읽던 위치 저장/복원 ──
      const fill = $("#read-fill");
      const POS_KEY = `daily.quiz.notes-pos.${location.pathname}`;
      const onReadScroll = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        fill.style.width = max > 0 ? `${(scrollY / max) * 100}%` : "0%";
        spy();
        try {
          localStorage.setItem(POS_KEY, String(Math.round(scrollY)));
        } catch {
          /* 저장 불가 환경 무시 */
        }
      };
      let rTicking = false;
      document.addEventListener(
        "scroll",
        () => {
          if (!rTicking) {
            rTicking = true;
            requestAnimationFrame(() => {
              rTicking = false;
              onReadScroll();
            });
          }
        },
        { passive: true },
      );
      // 앵커 진입이 아니면 읽던 위치로 복원
      if (!location.hash) {
        try {
          const saved = Number(localStorage.getItem(POS_KEY) ?? 0);
          if (saved > 300) scrollTo({ top: saved, behavior: "instant" as ScrollBehavior });
        } catch {
          /* ignore */
        }
      }
      onReadScroll();
    </script>
